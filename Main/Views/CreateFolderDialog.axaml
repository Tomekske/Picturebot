<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:vm="using:Main.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="Main.Views.CreateFolderDialog"
             x:DataType="vm:CreateFolderDialogViewModel">
    <suki:GlassCard Width="380" VerticalAlignment="Center" HorizontalAlignment="Center">
        <DockPanel LastChildFill="True" Margin="10">
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource folder_regular}" Width="20" Height="20" />
                    <TextBlock Text="New Folder" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Classes="Basic" DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Command="{Binding CancelCommand}">
                    <PathIcon Data="{StaticResource dismiss_regular}" Width="16" Height="16" />
                </Button>
            </DockPanel>

            <!-- Buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                        Margin="0,20,0,0">
                <Button Content="Cancel" Classes="Basic" Command="{Binding CancelCommand}" />
                <Button Content="Create Folder" Classes="Primary" Command="{Binding CreateFolderCommand}" />
            </StackPanel>

            <!-- Content -->
            <StackPanel Spacing="15">
                <StackPanel Spacing="5">
                    <TextBlock Text="Parent Location" FontSize="12" Opacity="0.6" />
                    <ComboBox ItemsSource="{Binding Parents}"
                              SelectedItem="{Binding SelectedParent}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocationItem">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Name" FontSize="12" Opacity="0.6" />
                    <TextBox Text="{Binding FolderName}"
                             Watermark="e.g. Projects"
                             HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </suki:GlassCard>
</UserControl>
