<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Main.ViewModels"
             x:DataType="vm:CreateFolderDialogViewModel"
             x:Class="Main.Views.CreateFolderDialog"
             Width="520">
    <Border Background="{DynamicResource SukiBackground}"
            CornerRadius="12"
            BoxShadow="0 4 20 0 #22000000"
            Padding="32">
        <StackPanel Spacing="32">
            <StackPanel Spacing="10">
                <TextBlock Text="New Folder"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="PARENT LOCATION"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SukiLowText}"
                           LetterSpacing="1" />
                <ComboBox ItemsSource="{Binding Parents}"
                          SelectedItem="{Binding SelectedParent}"
                          HorizontalAlignment="Stretch"
                          Height="40">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocationItem">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="NAME"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SukiLowText}"
                           LetterSpacing="1" />
                <TextBox Text="{Binding FolderName}"
                         Watermark="e.g. Projects"
                         Height="40"
                         VerticalContentAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
                <Button Command="{Binding CancelCommand}"
                        Content="Cancel"
                        Classes.Accent="False"
                        Width="100"
                        Height="40" />
                <Button Command="{Binding CreateFolderCommand}"
                        Content="Create Folder"
                        Classes.Accent="True"
                        Width="130"
                        Height="40" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
