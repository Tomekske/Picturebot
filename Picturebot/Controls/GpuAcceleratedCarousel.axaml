<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Picturebot.Controls">
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type controls:GpuAcceleratedCarousel}" TargetType="controls:GpuAcceleratedCarousel">
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Two slots take turns: one shows the current picture, the other slides the next one in -->
                    <Panel Background="{DynamicResource Photo.Backdrop}" ClipToBounds="True">
                        <Image Name="PART_SlotA" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Image Name="PART_SlotB" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
