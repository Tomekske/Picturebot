<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Picturebot.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:DataType="vm:LocationPickerViewModel"
             x:Class="Picturebot.Controls.LocationPicker">

    <UserControl.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
        </Style>

        <!-- Path bar segments -->
        <Style Selector="Button.crumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.crumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource State.Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        </Style>
        <Style Selector="Button.crumb.last">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.crumb.pending">
            <Setter Property="Foreground" Value="{DynamicResource Accent.Foreground}" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>

        <!-- Location rows -->
        <Style Selector="Border.row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource Surface.Card}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Control}">
        <Grid RowDefinitions="Auto, Auto, Auto">

            <!-- Path bar: click a segment to go up -->
            <ItemsControl ItemsSource="{Binding PathSegments}" Margin="6,6,6,2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PathSegment">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="›"
                                       IsVisible="{Binding !IsFirst}"
                                       Foreground="{DynamicResource Text.Muted}"
                                       VerticalAlignment="Center"
                                       Margin="1,0" />
                            <Button Classes="crumb"
                                    Classes.last="{Binding IsLast}"
                                    Classes.pending="{Binding IsPending}"
                                    Command="{Binding Command}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <icons:MaterialIcon Kind="Home" Width="14" Height="14"
                                                        IsVisible="{Binding IsFirst}" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Search / create -->
            <Border Grid.Row="1"
                    Margin="8,4,8,8"
                    Background="{DynamicResource Surface.Panel}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="8,0">
                <Grid ColumnDefinitions="Auto, *">
                    <icons:MaterialIcon Kind="Magnify" Width="16" Height="16"
                                        Foreground="{DynamicResource Text.Secondary}"
                                        VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             x:Name="QueryBox"
                             AutomationProperties.Name="Location search"
                             Text="{Binding Query}"
                             Watermark="Search all folders, or type a new folder name (a › b creates a path)"
                             Background="Transparent"
                             BorderThickness="0"
                             Height="34"
                             VerticalContentAlignment="Center"
                             KeyDown="QueryBox_KeyDown" />
                </Grid>
            </Border>

            <!-- One level at a time, or search results -->
            <Grid Grid.Row="2" RowDefinitions="Auto, *"
                  Margin="0,0,0,6">
                <Border Height="1" Background="{DynamicResource Border.Subtle}" />
                <ScrollViewer Grid.Row="1" Height="240" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ListHeader}"
                                   Classes="fieldLabel"
                                   Margin="14,6,14,4" />
                        <TextBlock Text="No subfolders here. Type a name above to create one."
                                   IsVisible="{Binding !HasRows}"
                                   Foreground="{DynamicResource Text.Muted}"
                                   FontSize="12"
                                   Margin="14,8" />
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="4,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LocationRow">
                                    <Border Classes="row" Tapped="Row_Tapped">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                            <icons:MaterialIcon Kind="{Binding Icon}"
                                                                Width="18" Height="18"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource Icon.Folder}"
                                                                IsVisible="{Binding IsFolder}" />
                                            <icons:MaterialIcon Kind="{Binding Icon}"
                                                                Width="18" Height="18"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource Accent.Foreground}"
                                                                IsVisible="{Binding IsCreate}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Text.Primary}" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           IsVisible="{Binding HasSubtitle}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Text.Secondary}" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    IsVisible="{Binding HasBadge}"
                                                    Background="{DynamicResource Surface.Raised}"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Margin="8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" FontSize="10"
                                                           Foreground="{DynamicResource Text.Secondary}" />
                                            </Border>
                                            <icons:MaterialIcon Grid.Column="3"
                                                                Kind="ChevronRight"
                                                                Width="16" Height="16"
                                                                IsVisible="{Binding ShowChevron}"
                                                                Foreground="{DynamicResource Text.Muted}"
                                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
