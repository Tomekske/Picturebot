<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="clr-namespace:SukiUI;assembly=SukiUI"
             x:Class="Picturebot.App"
             xmlns:local="using:Picturebot"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Picturebot/Themes/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <suki:SukiTheme ThemeColor="Blue" />
        <StyleInclude Source="avares://Picturebot/Themes/Controls.axaml" />
        <StyleInclude Source="avares://Material.Icons.Avalonia/MaterialIconStyles.xaml" />
        <StyleInclude Source="avares://Picturebot/Controls/GpuAcceleratedCarousel.axaml" />
    </Application.Styles>
</Application>
