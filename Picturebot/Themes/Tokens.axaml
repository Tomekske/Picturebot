<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Picturebot design tokens (dark only).
        Views must use these keys via {DynamicResource ...} and never hard-code colors.
        Brand palette: #FF2553 (pink, main accent), #FFB608 (amber, highlights), #00103C (navy, surface tint).
    -->

    <!-- ── Shape (same values as the Settings dialog) ─────────────────── -->
    <CornerRadius x:Key="Radius.Dialog">10</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>

    <!-- Dialog widths (DialogLayout.Size). Height follows content, capped at 85% of the window. -->
    <x:Double x:Key="Dialog.Width.Small">440</x:Double>
    <x:Double x:Key="Dialog.Width.Medium">560</x:Double>
    <x:Double x:Key="Dialog.Width.Large">860</x:Double>

    <!-- ── Surfaces (darkest → lightest) ─────────────────────────────── -->
    <Color x:Key="Color.Surface.App">#080C1C</Color>
    <Color x:Key="Color.Surface.Panel">#0E152C</Color>
    <Color x:Key="Color.Surface.Card">#141C36</Color>
    <Color x:Key="Color.Surface.Raised">#1C2544</Color>
    <Color x:Key="Color.Surface.Overlay">#CC050918</Color>

    <SolidColorBrush x:Key="Surface.App" Color="{StaticResource Color.Surface.App}" />
    <SolidColorBrush x:Key="Surface.Panel" Color="{StaticResource Color.Surface.Panel}" />
    <SolidColorBrush x:Key="Surface.Card" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="Surface.Raised" Color="{StaticResource Color.Surface.Raised}" />
    <SolidColorBrush x:Key="Surface.Raised.Hover" Color="#253052" />
    <SolidColorBrush x:Key="Surface.Overlay" Color="{StaticResource Color.Surface.Overlay}" />

    <!-- Neutral backdrop behind photos (no blue tint, so colors are judged correctly) -->
    <SolidColorBrush x:Key="Photo.Backdrop" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Photo.Placeholder" Color="#4A4A4A" />

    <!-- ── Accent (brand) ─────────────────────────────────────────────── -->
    <Color x:Key="Color.Accent.Fill">#E8174B</Color>
    <Color x:Key="Color.Accent.Secondary">#5A1640</Color>
    <Color x:Key="Color.Accent.Foreground">#FF5C7D</Color>

    <!-- Filled controls (primary button, active toggle). Text on top: Text.OnAccent -->
    <SolidColorBrush x:Key="Accent.Fill" Color="{StaticResource Color.Accent.Fill}" />
    <SolidColorBrush x:Key="Accent.Fill.Hover" Color="#FF2553" />
    <SolidColorBrush x:Key="Accent.Fill.Pressed" Color="#C4103C" />
    <!-- Selected tree item / row -->
    <SolidColorBrush x:Key="Accent.Selected" Color="{StaticResource Color.Accent.Secondary}" />
    <!-- Hover on navigation items, active filter chips -->
    <SolidColorBrush x:Key="Accent.Subtle" Color="#2A1A3E" />
    <!-- Accent drawn ON dark surfaces: links, icons, focus ring, selection outline -->
    <SolidColorBrush x:Key="Accent.Foreground" Color="{StaticResource Color.Accent.Foreground}" />

    <!-- ── Interaction states (translucent, work on any surface) ───────── -->
    <SolidColorBrush x:Key="State.Hover" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="State.Active" Color="#25FFFFFF" />
    <SolidColorBrush x:Key="State.ActiveHover" Color="#35FFFFFF" />

    <!-- ── Text ───────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Text.Primary" Color="#ECECF4" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#A3AAC2" />
    <SolidColorBrush x:Key="Text.Muted" Color="#6C7493" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />

    <!-- ── Borders ────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Border.Subtle" Color="#232D4C" />
    <SolidColorBrush x:Key="Border.Strong" Color="#323E64" />

    <!-- ── Status (semantic, not brand) ───────────────────────────────── -->
    <SolidColorBrush x:Key="Status.Picked" Color="#3FB950" />
    <SolidColorBrush x:Key="Status.Picked.Subtle" Color="#1C3326" />
    <SolidColorBrush x:Key="Status.Picked.Border" Color="#2D5A3A" />
    <SolidColorBrush x:Key="Status.Danger.Subtle" Color="#3A1E22" />
    <SolidColorBrush x:Key="Status.Rejected" Color="#F85149" />
    <SolidColorBrush x:Key="Status.Warning" Color="#D29922" />
    <SolidColorBrush x:Key="Status.Danger" Color="#F85149" />
    <SolidColorBrush x:Key="Status.Danger.Fill" Color="#B62324" />
    <SolidColorBrush x:Key="Status.Danger.Fill.Hover" Color="#D12D2E" />
    <SolidColorBrush x:Key="Status.Rating" Color="#FFB608" />

    <!-- ── Color labels (fixed, match Lightroom/DxO meaning) ──────────── -->
    <Color x:Key="Color.Label.Red">#E5484D</Color>
    <Color x:Key="Color.Label.Orange">#F2994A</Color>
    <Color x:Key="Color.Label.Yellow">#F2C94C</Color>
    <Color x:Key="Color.Label.Green">#46A758</Color>
    <Color x:Key="Color.Label.Blue">#3BA0F6</Color>
    <Color x:Key="Color.Label.Pink">#E86FA9</Color>
    <Color x:Key="Color.Label.Purple">#A371F7</Color>

    <SolidColorBrush x:Key="Label.Red" Color="{StaticResource Color.Label.Red}" />
    <SolidColorBrush x:Key="Label.Orange" Color="{StaticResource Color.Label.Orange}" />
    <SolidColorBrush x:Key="Label.Yellow" Color="{StaticResource Color.Label.Yellow}" />
    <SolidColorBrush x:Key="Label.Green" Color="{StaticResource Color.Label.Green}" />
    <SolidColorBrush x:Key="Label.Blue" Color="{StaticResource Color.Label.Blue}" />
    <SolidColorBrush x:Key="Label.Pink" Color="{StaticResource Color.Label.Pink}" />
    <SolidColorBrush x:Key="Label.Purple" Color="{StaticResource Color.Label.Purple}" />
    <SolidColorBrush x:Key="Label.None" Color="#6E6E80" />

    <!-- ── Icons (high contrast on dark surfaces) ─────────────────────── -->
    <!-- Default icon / icon-button color: near-white so toolbars don't look washed out -->
    <SolidColorBrush x:Key="Icon.Default" Color="#E8E8F2" />
    <!-- Hover / active: brand amber -->
    <SolidColorBrush x:Key="Icon.Hover" Color="#FFC33D" />
    <SolidColorBrush x:Key="Icon.Disabled" Color="#5A5A68" />

    <!-- ── Node icons ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Icon.Folder" Color="#FFB608" />
    <SolidColorBrush x:Key="Icon.Album" Color="{StaticResource Color.Accent.Foreground}" />

    <!-- ── SukiUI overrides: map Suki's dark keys onto the tokens above ── -->
    <Color x:Key="SukiBackground">#080C1C</Color>
    <Color x:Key="SukiStrongBackground">#1C2544</Color>
    <Color x:Key="SukiLightBackground">#0E152C</Color>
    <Color x:Key="SukiCardBackground">#141C36</Color>
    <Color x:Key="SukiPopupBackground">#0E152C</Color>
    <Color x:Key="SukiGlassCardBackground">#141C36</Color>
    <Color x:Key="SukiGlassCardOpaqueBackground">#141C36</Color>
    <Color x:Key="ControlSukiGlassCardBackground">#141C36</Color>
    <Color x:Key="SukiControlTouchBackground">#1C2544</Color>
    <Color x:Key="SukiDialogBackground">#050918</Color>
    <Color x:Key="SukiBorderBrush">#232D4C</Color>
    <Color x:Key="SukiControlBorderBrush">#323E64</Color>
    <Color x:Key="SukiMediumBorderBrush">#323E64</Color>
    <Color x:Key="SukiLightBorderBrush">#232D4C</Color>
    <Color x:Key="SukiMenuBorderBrush">#232D4C</Color>
    <Color x:Key="GlassBorderBrush">#232D4C</Color>
    <Color x:Key="SukiText">#ECECF4</Color>
    <Color x:Key="SukiLowText">#A3AAC2</Color>
    <Color x:Key="SukiMuteText">#6C7493</Color>
    <Color x:Key="SukiDisabledText">#5A5A68</Color>
    <Color x:Key="SukiSuccessColor">#3FB950</Color>
    <Color x:Key="SukiInformationColor">#FF2553</Color>
    <Color x:Key="SukiWarningColor">#D29922</Color>
    <Color x:Key="SukiDangerColor">#F85149</Color>
    <x:Double x:Key="GlassOpacity">1</x:Double>
    <x:Double x:Key="ControlGlassOpacity">1</x:Double>
    <x:Double x:Key="DiscreteControlGlassOpacity">1</x:Double>
</ResourceDictionary>
