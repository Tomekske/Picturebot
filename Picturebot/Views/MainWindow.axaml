<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:views="clr-namespace:Picturebot.Views"
                 xmlns:vm="using:Picturebot.ViewModels"
                 xmlns:enums="using:Domain.Enums"
                 x:Class="Picturebot.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Title="Picturebot"
                 Icon="/Assets/icon.ico"
                 Width="1200" Height="800"
                 Background="{DynamicResource Surface.App}"
                 BackgroundAnimationEnabled="False"
                 BackgroundTransitionsEnabled="False">

    <suki:SukiWindow.KeyBindings>
        <KeyBinding Gesture="Shift+P" Command="{Binding GalleryVM.ShowPickedOnlyCommand}" />
        <KeyBinding Gesture="Shift+R" Command="{Binding GalleryVM.ClearAllFiltersCommand}" />
    </suki:SukiWindow.KeyBindings>

    <!-- Main layout is window content so SukiUI keeps its title bar (minimize / maximize / close) above it -->
    <DockPanel LastChildFill="True" Background="{DynamicResource Surface.App}">
        <!-- Status Bar at the bottom -->
        <Border DockPanel.Dock="Bottom"
                Height="30"
                Background="{DynamicResource Surface.Panel}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0">
            <views:StatusBarView DataContext="{Binding StatusBarVM}" />
        </Border>

        <!-- Picturebot Content Area -->
        <Grid ColumnDefinitions="350, *, Auto">
            <Border Grid.Column="0" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
                <views:NavigationPaneView DataContext="{Binding NavigationPaneVM}" />
            </Border>

            <views:GalleryView Grid.Column="1" Margin="10" DataContext="{Binding GalleryVM}" />

            <!-- Details only while a picture is selected (selection is cleared when navigating away from an album) -->
            <Border Grid.Column="2" Width="350"
                    IsVisible="{Binding DetailsInspectorVM.HasSelection}"
                    Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,0,0,0">
                <views:DetailsInspectorView DataContext="{Binding DetailsInspectorVM}" />
            </Border>
        </Grid>
    </DockPanel>

    <suki:SukiWindow.Hosts>
        <suki:SukiDialogHost Name="DialogHost" />
        <suki:SukiToastHost Name="ToastHost" />
    </suki:SukiWindow.Hosts>
</suki:SukiWindow>
