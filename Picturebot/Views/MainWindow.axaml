<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:views="clr-namespace:Picturebot.Views"
                 xmlns:vm="using:Picturebot.ViewModels"
                 xmlns:enums="using:Domain.Enums"
                 x:Class="Picturebot.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Title="Picturebot"
                 Icon="/Assets/icon.ico"
                 Width="1200" Height="800">

    <suki:SukiWindow.KeyBindings>
        <KeyBinding Gesture="Shift+P" Command="{Binding GalleryVM.ShowPickedOnlyCommand}" />
        <KeyBinding Gesture="Shift+R" Command="{Binding GalleryVM.ClearAllFiltersCommand}" />

        <KeyBinding Gesture="P" Command="{Binding GalleryVM.SetCurationStatusCommand}"
                    CommandParameter="{x:Static enums:CurationStatus.Flagged}" />
        <KeyBinding Gesture="X" Command="{Binding GalleryVM.SetCurationStatusCommand}"
                    CommandParameter="{x:Static enums:CurationStatus.Rejected}" />
        <KeyBinding Gesture="U" Command="{Binding GalleryVM.SetCurationStatusCommand}"
                    CommandParameter="{x:Static enums:CurationStatus.Unflagged}" />

        <KeyBinding Gesture="Ctrl+E" Command="{Binding GalleryVM.CopyToEditCommand}" />
        <KeyBinding Gesture="Shift+E" Command="{Binding GalleryVM.CopyToPrintCommand}" />
    </suki:SukiWindow.KeyBindings>

    <suki:SukiWindow.Hosts>
        <DockPanel LastChildFill="True">
            <!-- Status Bar at the bottom -->
            <Border DockPanel.Dock="Bottom"
                    Height="30"
                    Background="#252525"
                    BorderBrush="#333333"
                    BorderThickness="0,1,0,0">
                <views:StatusBarView DataContext="{Binding StatusBarVM}" />
            </Border>

            <!-- Picturebot Content Area -->
            <Grid ColumnDefinitions="350, *, 350">
                <Border Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,1,0">
                    <views:NavigationPaneView DataContext="{Binding NavigationPaneVM}" />
                </Border>

                <views:GalleryView Grid.Column="1" Margin="10" DataContext="{Binding GalleryVM}" />

                <Border Grid.Column="2" BorderBrush="#333333" BorderThickness="1,0,0,0">
                    <views:DetailsInspectorView DataContext="{Binding DetailsInspectorVM}" />
                </Border>
            </Grid>
        </DockPanel>
        <suki:SukiDialogHost Name="DialogHost" />
        <suki:SukiToastHost Name="ToastHost" />
    </suki:SukiWindow.Hosts>
</suki:SukiWindow>
