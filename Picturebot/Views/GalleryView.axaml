<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Picturebot.ViewModels;assembly=Picturebot"
             xmlns:entities="using:Database.Domain.Entities"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:converters="using:Picturebot.Converters"
             xmlns:controls="using:Picturebot.Controls"
             xmlns:enums="using:Domain.Enums"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Picturebot.Views.GalleryView"
             x:DataType="vm:GalleryViewModel">

    

    <UserControl.Resources>
        <converters:NodeTypeToBooleanConverter x:Key="NodeTypeToBooleanConverter" />
        <converters:CurationStatusToBooleanConverter x:Key="CurationStatusToBooleanConverter" />
        <converters:ColorLabelToBrushConverter x:Key="ColorLabelToBrushConverter" />
        <converters:RatingToBooleanConverter x:Key="RatingToBooleanConverter" />
    </UserControl.Resources>

    <Grid Margin="0,40,0,0" RowDefinitions="Auto,Auto,*">
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Breadcrumbs}"
                      Margin="24,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BreadcrumbItem">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="Basic"
                                Padding="6,4"
                                CornerRadius="6"
                                Command="{Binding $parent[ItemsControl].((vm:GalleryViewModel)DataContext).NavigateToBreadcrumbCommand}"
                                CommandParameter="{Binding}"
                                Cursor="Hand">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SukiText}" />
                        </Button>

                        <icons:MaterialIcon Kind="ChevronRight"
                                            IsVisible="{Binding !IsLast}"
                                            VerticalAlignment="Center"
                                            Margin="2,0"
                                            Width="18" Height="18"
                                            Foreground="{DynamicResource SukiLowText}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="1"
                Margin="20,0,20,15"
                Padding="8,4"
                Background="{DynamicResource SukiGlassCardBackground}"
                BorderBrush="{DynamicResource SukiBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Classes="Basic" ToolTip.Tip="Open in File Explorer (O)"
                            Command="{Binding OpenInExplorerCommand}"
                            IsEnabled="{Binding CanPlayCarousel}">
                        <icons:MaterialIcon Kind="FolderOpen" Width="20" Height="20" />
                    </Button>
                    <Separator Width="1" Height="20" Background="{DynamicResource SukiBorderBrush}" Margin="4,0" />

                    <Button Classes="Basic" ToolTip.Tip="Play Carousel (F)"
                            Command="{Binding PlayCarouselCommand}"
                            IsEnabled="{Binding CanPlayCarousel}">
                        <icons:MaterialIcon Kind="Play" Width="20" Height="20" />
                    </Button>
                    <Separator Width="1" Height="20" Background="{DynamicResource SukiBorderBrush}" Margin="4,0" />
                    <Button Classes="Basic" ToolTip.Tip="Add Picture">
                        <icons:MaterialIcon Kind="Plus" Width="20" Height="20" />
                    </Button>
                    <ToggleButton Classes="Basic"
                                  ToolTip.Tip="Toggle Burst Grouping"
                                  IsChecked="{Binding IsBurstViewEnabled, Mode=TwoWay}"
                                  Command="{Binding ToggleGroupingModeCommand}"
                                  IsEnabled="{Binding CanPlayCarousel}">
                        <Panel>
                            <icons:MaterialIcon Kind="CalendarMonth"
                                                IsVisible="{Binding IsBurstViewEnabled}"
                                                Width="20" Height="20" />
                            <icons:MaterialIcon Kind="LayersOutline"
                                                IsVisible="{Binding !IsBurstViewEnabled}"
                                                Width="20" Height="20" />
                        </Panel>
                    </ToggleButton>
                    <Separator Width="1" Height="20"
                               IsVisible="{Binding IsBurstViewEnabled}"
                               Background="{DynamicResource SukiBorderBrush}" Margin="4,0" />

                    <Button Classes="Basic" ToolTip.Tip="Auto Flag Picture"
                            IsVisible="{Binding IsBurstViewEnabled}"
                            Command="{Binding AutoFlagBestPicturesCommand}">
                        <icons:MaterialIcon Kind="AutoFix" Width="20" Height="20"
                                            Foreground="{DynamicResource SukiPrimaryColor}" />
                    </Button>

                    <Button Classes="Basic" ToolTip.Tip="Filter">
                        <icons:MaterialIcon Kind="Filter" Width="20" Height="20" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <Border Background="{DynamicResource SukiCardBackground}"
                                        BorderBrush="{DynamicResource SukiBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="8">
                                    <Border.KeyBindings>
                                        <KeyBinding Gesture="Shift+P" Command="{Binding ShowPickedOnlyCommand}" />
                                        <KeyBinding Gesture="Shift+R" Command="{Binding ClearAllFiltersCommand}" />
                                    </Border.KeyBindings>
                                    <ScrollViewer MaxHeight="500">
                                        <StackPanel Spacing="4" Width="220">
                                            
                                            <!-- Reset Filters -->
                                            <Button Classes="Basic" Command="{Binding ClearAllFiltersCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <icons:MaterialIcon Kind="FilterRemoveOutline" Width="18" Height="18" Foreground="{DynamicResource SukiLowText}"/>
                                                    <TextBlock Text="Reset Filters" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Section 1: Curation Status -->
                                            <TextBlock Text="Curation Status" FontSize="11" FontWeight="Bold"
                                                       Margin="8,4" Foreground="{DynamicResource SukiLowText}" />

                                            <CheckBox IsChecked="{Binding IsFlaggedFilterActive, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <icons:MaterialIcon Kind="Flag" Foreground="#4CAF50" Width="18"
                                                                        Height="18" />
                                                    <TextBlock Text="Picked images" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>

                                            <CheckBox IsChecked="{Binding IsUnflaggedFilterActive, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <icons:MaterialIcon Kind="CircleOutline" Foreground="Gray"
                                                                        Width="18" Height="18" />
                                                    <TextBlock Text="Untagged images" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>

                                            <CheckBox IsChecked="{Binding IsRejectedFilterActive, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <icons:MaterialIcon Kind="CloseCircle" Foreground="#F44336"
                                                                        Width="18" Height="18" />
                                                    <TextBlock Text="Rejected images" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>

                                            <Separator Height="1" Background="{DynamicResource SukiBorderBrush}"
                                                       Margin="0,4" />

                                            <!-- Section 2: Star Ratings -->
                                            <TextBlock Text="Star Ratings" FontSize="11" FontWeight="Bold" Margin="8,4"
                                                       Foreground="{DynamicResource SukiLowText}" />

                                            <!-- 5 Stars -->
                                            <CheckBox IsChecked="{Binding IsFiveStarFilterActive, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- 4 Stars -->
                                            <CheckBox IsChecked="{Binding IsFourStarFilterActive, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- 3 Stars -->
                                            <CheckBox IsChecked="{Binding IsThreeStarFilterActive, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- 2 Stars -->
                                            <CheckBox IsChecked="{Binding IsTwoStarFilterActive, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- 1 Star -->
                                            <CheckBox IsChecked="{Binding IsOneStarFilterActive, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <icons:MaterialIcon Kind="Star" Foreground="Gold" Width="14"
                                                                        Height="14" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- 0 Stars (Unrated) -->
                                            <CheckBox IsChecked="{Binding IsZeroStarFilterActive, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <icons:MaterialIcon Kind="StarOffOutline" Foreground="{DynamicResource SukiLowText}" Width="14"
                                                                        Height="14" />
                                                    <TextBlock Text="Unrated" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>

                                            <Separator Height="1" Background="{DynamicResource SukiBorderBrush}"
                                                       Margin="0,4" />

                                            <!-- Section 3: Color Labels -->
                                            <TextBlock Text="Color Labels" FontSize="11" FontWeight="Bold" Margin="8,4"
                                                       Foreground="{DynamicResource SukiLowText}" />

                                            <!-- None -->
                                            <CheckBox IsChecked="{Binding IsNoneColorFilterActive, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <icons:MaterialIcon Kind="CircleOutline"
                                                                        Foreground="{DynamicResource SukiLowText}"
                                                                        Width="18" Height="18" />
                                                    <TextBlock Text="None" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- Red -->
                                            <CheckBox IsChecked="{Binding IsRedColorFilterActive, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <icons:MaterialIcon Kind="Circle" Foreground="#B71C1C" Width="18"
                                                                        Height="18" />
                                                    <TextBlock Text="Red" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- Orange -->
                                            <CheckBox IsChecked="{Binding IsOrangeColorFilterActive, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <icons:MaterialIcon Kind="Circle" Foreground="#E67E22" Width="18"
                                                                        Height="18" />
                                                    <TextBlock Text="Orange" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- Yellow -->
                                            <CheckBox IsChecked="{Binding IsYellowColorFilterActive, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <icons:MaterialIcon Kind="Circle" Foreground="#CCCC33" Width="18"
                                                                        Height="18" />
                                                    <TextBlock Text="Yellow" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- Green -->
                                            <CheckBox IsChecked="{Binding IsGreenColorFilterActive, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <icons:MaterialIcon Kind="Circle" Foreground="#33CC33" Width="18"
                                                                        Height="18" />
                                                    <TextBlock Text="Green" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- Blue -->
                                            <CheckBox IsChecked="{Binding IsBlueColorFilterActive, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <icons:MaterialIcon Kind="Circle" Foreground="#3333CC" Width="18"
                                                                        Height="18" />
                                                    <TextBlock Text="Blue" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- Pink -->
                                            <CheckBox IsChecked="{Binding IsPinkColorFilterActive, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <icons:MaterialIcon Kind="Circle" Foreground="#F06292" Width="18"
                                                                        Height="18" />
                                                    <TextBlock Text="Pink" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- Purple -->
                                            <CheckBox IsChecked="{Binding IsPurpleColorFilterActive, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <icons:MaterialIcon Kind="Circle" Foreground="#CC33CC" Width="18"
                                                                        Height="18" />
                                                    <TextBlock Text="Purple" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="Basic" ToolTip.Tip="Sort">
                        <icons:MaterialIcon Kind="SortVariant" Width="20" Height="20" />
                    </Button>
                    <Separator Width="1" Height="20" Background="{DynamicResource SukiBorderBrush}" Margin="4,0" IsVisible="{Binding IsShowingAlbum}" />
                    <Button Classes="Basic" ToolTip.Tip="Actions" IsVisible="{Binding IsShowingAlbum}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <icons:MaterialIcon Kind="LightningBolt" Width="20" Height="20" Foreground="{DynamicResource SukiPrimaryColor}" />
                            <icons:MaterialIcon Kind="ChevronDown" Width="16" Height="16" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Sync Curation Status with 'Picked' Folder"
                                          Command="{Binding SyncCurationStatusWithPickedFolderCommand}">
                                    <MenuItem.Icon>
                                        <icons:MaterialIcon Kind="FolderSyncOutline" Width="18" Height="18" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Create XMP files"
                                          Command="{Binding CreateXmpFilesCommand}">
                                    <MenuItem.Icon>
                                        <icons:MaterialIcon Kind="FileExportOutline" Width="18" Height="18" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" IsVisible="{Binding !IsLibraryRoot}">
                    <Button Classes="Basic" ToolTip.Tip="Edit"
                            Command="{Binding EditCurrentNodeCommand}">
                        <icons:MaterialIcon Kind="PencilOutline" Width="20" Height="20" />
                    </Button>

                    <Button Classes="Basic" ToolTip.Tip="Delete" Foreground="Red"
                            Command="{Binding DeleteCurrentNodeCommand}">
                        <icons:MaterialIcon Kind="DeleteOutline" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Panel Grid.Row="2">

            <!-- Empty State for Folders -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsShowingAlbum" />
                        <Binding Path="!Items.Count" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <icons:MaterialIcon Kind="FolderOpen" Width="64" Height="64" Foreground="{DynamicResource SukiLowText}" />
                <TextBlock Text="This folder is empty" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource SukiLowText}" />
            </StackPanel>

            <!-- Empty State for Albums -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsShowingAlbum" />
                        <Binding Path="!PicturesList.Count" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <icons:MaterialIcon Kind="ImageAlbum" Width="64" Height="64" Foreground="{DynamicResource SukiLowText}" />
                <TextBlock Text="This album is empty" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource SukiLowText}" />
            </StackPanel>

            <ScrollViewer IsVisible="{Binding !IsShowingAlbum}" Padding="20,10,20,20">
                <StackPanel Spacing="30">
                    <!-- Folders Section -->
                    <StackPanel Spacing="10" IsVisible="{Binding FolderItems.Count}">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="5,0">
                            <icons:MaterialIcon Kind="FolderOutline" Width="20" Height="20"
                                                Foreground="{DynamicResource SukiLowText}" />
                            <TextBlock Text="Folders" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SukiText}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding FolderItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="entities:Node">
                                    <Button Classes="Basic"
                                            Command="{Binding $parent[ItemsControl].((vm:GalleryViewModel)DataContext).NavigateToChildCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="10"
                                            Padding="0"
                                            CornerRadius="12"
                                            Cursor="Hand">
                                        <suki:GlassCard Width="160" Height="140">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Spacing="10">
                                                <Panel Width="48" Height="48">
                                                    <icons:MaterialIcon Kind="Folder"
                                                                        IsVisible="{Binding Type, Converter={StaticResource NodeTypeToBooleanConverter}, ConverterParameter=Folder}"
                                                                        Width="48" Height="48" Foreground="#FFD700" />
                                                    <icons:MaterialIcon Kind="ImageAlbum"
                                                                        IsVisible="{Binding Type, Converter={StaticResource NodeTypeToBooleanConverter}, ConverterParameter=Album}"
                                                                        Width="48" Height="48" Foreground="#87CEEB" />
                                                </Panel>
                                                <TextBlock Text="{Binding Name}"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SukiText}" />
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Albums Section -->
                    <StackPanel Spacing="10" IsVisible="{Binding AlbumItems.Count}">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="5,0">
                            <icons:MaterialIcon Kind="ImageAlbum" Width="20" Height="20"
                                                Foreground="{DynamicResource SukiLowText}" />
                            <TextBlock Text="Albums" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SukiText}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding AlbumItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="entities:Node">
                                    <Button Classes="Basic"
                                            Command="{Binding $parent[ItemsControl].((vm:GalleryViewModel)DataContext).NavigateToChildCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="10"
                                            Padding="0"
                                            CornerRadius="12"
                                            Cursor="Hand">
                                        <suki:GlassCard Width="160" Height="140">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Spacing="10">
                                                <Panel Width="48" Height="48">
                                                    <icons:MaterialIcon Kind="Folder"
                                                                        IsVisible="{Binding Type, Converter={StaticResource NodeTypeToBooleanConverter}, ConverterParameter=Folder}"
                                                                        Width="48" Height="48" Foreground="#FFD700" />
                                                    <icons:MaterialIcon Kind="ImageAlbum"
                                                                        IsVisible="{Binding Type, Converter={StaticResource NodeTypeToBooleanConverter}, ConverterParameter=Album}"
                                                                        Width="48" Height="48" Foreground="#87CEEB" />
                                                </Panel>
                                                <TextBlock Text="{Binding Name}"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SukiText}" />
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsShowingAlbum}" Padding="20,10,20,20">
                <ItemsControl ItemsSource="{Binding GroupedPictures}"
                              Background="Transparent">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PictureGroupViewModel">
                            <StackPanel Spacing="10" Margin="0,0,0,30">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="5,0">
                                    <icons:MaterialIcon Kind="BurstMode"
                                                        IsVisible="{Binding IsBurstGroup}"
                                                        Width="20" Height="20"
                                                        Foreground="{DynamicResource SukiPrimaryColor}" />
                                    <icons:MaterialIcon Kind="CalendarToday"
                                                        IsVisible="{Binding !IsBurstGroup}"
                                                        Width="20" Height="20"
                                                        Foreground="{DynamicResource SukiLowText}" />
                                    <TextBlock Text="{Binding Header}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SukiText}" />
                                </StackPanel>

                                <ListBox ItemsSource="{Binding Pictures}"
                                         SelectedItem="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).SelectedPicture, Mode=OneWay}"
                                         SelectionChanged="OnSelectionChanged"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem" x:DataType="vm:PictureItemViewModel">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Width" Value="240" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <ControlTemplate>
                                                    <controls:AspectRatioPanel Ratio="0.85" Margin="8">
                                                        <!-- The 'Matted Print' Border -->
                                                        <Border Name="PART_AspectBorder"
                                                                Background="#1C232E"
                                                                BorderBrush="#3A4454"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                ClipToBounds="True">
                                                            <Grid RowDefinitions="*,Auto">
                                                                <!-- Color Label Background Overlay -->
                                                                <Border Grid.RowSpan="2"
                                                                        Background="{Binding ColorLabel, Converter={StaticResource ColorLabelToBrushConverter}}"
                                                                        Opacity="0.18" />

                                                                <Panel Grid.Row="0" Margin="8">
                                                                    <Image Source="{Binding Thumbnail}"
                                                                           Classes.loaded="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                           Stretch="Uniform"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           EffectiveViewportChanged="OnImageEffectiveViewportChanged">
                                                                        <Image.Transitions>
                                                                            <Transitions>
                                                                                <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                                                                            </Transitions>
                                                                        </Image.Transitions>
                                                                        <Image.Styles>
                                                                            <Style Selector="Image">
                                                                                <Setter Property="Opacity" Value="0" />
                                                                            </Style>
                                                                            <Style Selector="Image.loaded">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </Style>
                                                                        </Image.Styles>
                                                                    </Image>

                                                                    <!-- Top Left: Flagged Indicator -->
                                                                    <Border VerticalAlignment="Top"
                                                                            HorizontalAlignment="Left"
                                                                            Margin="4"
                                                                            Padding="4"
                                                                            CornerRadius="4"
                                                                            Background="#80000000"
                                                                            IsVisible="{Binding CurationStatus, Converter={StaticResource CurationStatusToBooleanConverter}, ConverterParameter=Flagged}">
                                                                        <icons:MaterialIcon Kind="Flag"
                                                                                Width="16" Height="16"
                                                                                Foreground="#4CAF50" />
                                                                    </Border>
                                                                </Panel>

                                                                <!-- Metadata Section -->
                                                                <StackPanel Grid.Row="1" Spacing="4" Margin="8,0,8,8">
                                                                    <!-- Rating Indicator -->
                                                                    <StackPanel HorizontalAlignment="Center"
                                                                            Orientation="Horizontal"
                                                                            Spacing="1">
                                                                        <Panel>
                                                                            <icons:MaterialIcon Kind="StarOutline"
                                                                                    Width="10" Height="10"
                                                                                    Foreground="Gray" Opacity="0.5"
                                                                                    IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!1}" />
                                                                            <icons:MaterialIcon Kind="Star" Width="10"
                                                                                    Height="10" Foreground="Gold"
                                                                                    IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=1}" />
                                                                        </Panel>
                                                                        <Panel>
                                                                            <icons:MaterialIcon Kind="StarOutline"
                                                                                    Width="10" Height="10"
                                                                                    Foreground="Gray" Opacity="0.5"
                                                                                    IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!2}" />
                                                                            <icons:MaterialIcon Kind="Star" Width="10"
                                                                                    Height="10" Foreground="Gold"
                                                                                    IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=2}" />
                                                                        </Panel>
                                                                        <Panel>
                                                                            <icons:MaterialIcon Kind="StarOutline"
                                                                                    Width="10" Height="10"
                                                                                    Foreground="Gray" Opacity="0.5"
                                                                                    IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!3}" />
                                                                            <icons:MaterialIcon Kind="Star" Width="10"
                                                                                    Height="10" Foreground="Gold"
                                                                                    IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=3}" />
                                                                        </Panel>
                                                                        <Panel>
                                                                            <icons:MaterialIcon Kind="StarOutline"
                                                                                    Width="10" Height="10"
                                                                                    Foreground="Gray" Opacity="0.5"
                                                                                    IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!4}" />
                                                                            <icons:MaterialIcon Kind="Star" Width="10"
                                                                                    Height="10" Foreground="Gold"
                                                                                    IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=4}" />
                                                                        </Panel>
                                                                        <Panel>
                                                                            <icons:MaterialIcon Kind="StarOutline"
                                                                                    Width="10" Height="10"
                                                                                    Foreground="Gray" Opacity="0.5"
                                                                                    IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!5}" />
                                                                            <icons:MaterialIcon Kind="Star" Width="10"
                                                                                    Height="10" Foreground="Gold"
                                                                                    IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=5}" />
                                                                        </Panel>
                                                                    </StackPanel>

                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="White"
                                                                               TextAlignment="Center"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Selection Indicator overlay (Blue) -->
                                                        <Border Name="SelectionIndicator"
                                                                BorderBrush="#0078FF"
                                                                BorderThickness="2"
                                                                CornerRadius="4"
                                                                IsHitTestVisible="False"
                                                                IsVisible="False" />
                                                    </controls:AspectRatioPanel>
                                                </ControlTemplate>
                                            </Setter>
                                        </Style>

                                        <Style Selector="ListBoxItem:pointerover /template/ Border#PART_AspectBorder">
                                            <Setter Property="Background" Value="#252E3B" />
                                        </Style>

                                        <Style Selector="ListBoxItem:selected /template/ Border#SelectionIndicator">
                                            <Setter Property="IsVisible" Value="True" />
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Panel>
    </Grid>

</UserControl>
