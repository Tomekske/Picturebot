<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Picturebot.ViewModels;assembly=Picturebot"
             xmlns:entities="using:Database.Domain.Entities"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:converters="using:Picturebot.Converters"
             xmlns:controls="using:Picturebot.Controls"
             xmlns:enums="using:Domain.Enums"
             xmlns:labs="clr-namespace:Avalonia.Labs.Panels;assembly=Avalonia.Labs.Panels"
             xmlns:views="using:Picturebot.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Picturebot.Views.GalleryView"
             x:DataType="vm:GalleryViewModel">

    

    <UserControl.Resources>
        <converters:NodeTypeToBooleanConverter x:Key="NodeTypeToBooleanConverter" />
        <converters:CurationStatusToBooleanConverter x:Key="CurationStatusToBooleanConverter" />
        <converters:ColorLabelToBrushConverter x:Key="ColorLabelToBrushConverter" />
        <converters:RatingToBooleanConverter x:Key="RatingToBooleanConverter" />
    </UserControl.Resources>

    <Grid Margin="0,40,0,0" RowDefinitions="Auto,Auto,*">
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Breadcrumbs}"
                      Margin="24,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BreadcrumbItem">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="Basic"
                                Padding="6,4"
                                CornerRadius="6"
                                Command="{Binding $parent[ItemsControl].((vm:GalleryViewModel)DataContext).NavigateToBreadcrumbCommand}"
                                CommandParameter="{Binding}"
                                Cursor="Hand">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SukiText}" />
                        </Button>

                        <icons:MaterialIcon Kind="ChevronRight"
                                            IsVisible="{Binding !IsLast}"
                                            VerticalAlignment="Center"
                                            Margin="2,0"
                                            Width="18" Height="18"
                                            Foreground="{DynamicResource SukiLowText}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="1"
                Margin="20,0,20,15"
                Padding="8,4"
                Background="{DynamicResource SukiGlassCardBackground}"
                BorderBrush="{DynamicResource SukiBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Classes="Basic" ToolTip.Tip="Open in File Explorer (O)"
                            Command="{Binding OpenInExplorerCommand}"
                            IsEnabled="{Binding CanPlayCarousel}">
                        <icons:MaterialIcon Kind="FolderOpen" Width="20" Height="20" />
                    </Button>
                    <Button Classes="Basic" ToolTip.Tip="Open in DxO PhotoLab"
                            Command="{Binding OpenInDxoCommand}"
                            IsEnabled="{Binding CanPlayCarousel}">
                        <icons:MaterialIcon Kind="OpenInApp" Width="20" Height="20" />
                    </Button>
                    <Separator Width="1" Height="20" Background="{DynamicResource SukiBorderBrush}" Margin="4,0" />

                    <Button Classes="Basic" ToolTip.Tip="Play Carousel (F)"
                            Command="{Binding PlayCarouselCommand}"
                            IsEnabled="{Binding CanPlayCarousel}">
                        <icons:MaterialIcon Kind="Play" Width="20" Height="20" />
                    </Button>
                    <Separator Width="1" Height="20" Background="{DynamicResource SukiBorderBrush}" Margin="4,0" />
                    <Button Classes="Basic" ToolTip.Tip="Add Picture">
                        <icons:MaterialIcon Kind="Plus" Width="20" Height="20" />
                    </Button>
                    <ToggleButton Classes="Basic"
                                  ToolTip.Tip="Toggle Burst Grouping"
                                  IsChecked="{Binding IsBurstViewEnabled, Mode=TwoWay}"
                                  Command="{Binding ToggleGroupingModeCommand}"
                                  IsEnabled="{Binding CanPlayCarousel}">
                        <Panel>
                            <icons:MaterialIcon Kind="CalendarMonth"
                                                IsVisible="{Binding IsBurstViewEnabled}"
                                                Width="20" Height="20" />
                            <icons:MaterialIcon Kind="LayersOutline"
                                                IsVisible="{Binding !IsBurstViewEnabled}"
                                                Width="20" Height="20" />
                        </Panel>
                    </ToggleButton>
                    <Separator Width="1" Height="20"
                               IsVisible="{Binding IsBurstViewEnabled}"
                               Background="{DynamicResource SukiBorderBrush}" Margin="4,0" />

                    <Button Classes="Basic" ToolTip.Tip="Auto Flag Picture"
                            IsVisible="{Binding IsBurstViewEnabled}"
                            Command="{Binding AutoFlagBestPicturesCommand}">
                        <icons:MaterialIcon Kind="AutoFix" Width="20" Height="20"
                                            Foreground="{DynamicResource SukiPrimaryColor}" />
                    </Button>

                    <views:FilterToolbarView DataContext="{Binding FilterToolbar}" VerticalAlignment="Center" Margin="4,0" />
                    <Button Classes="Basic" ToolTip.Tip="Sort">
                        <icons:MaterialIcon Kind="SortVariant" Width="20" Height="20" />
                    </Button>
                    <Separator Width="1" Height="20" Background="{DynamicResource SukiBorderBrush}" Margin="4,0" IsVisible="{Binding IsShowingAlbum}" />
                    <Button Classes="Basic" ToolTip.Tip="Actions" IsVisible="{Binding IsShowingAlbum}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <icons:MaterialIcon Kind="LightningBolt" Width="20" Height="20" Foreground="{DynamicResource SukiPrimaryColor}" />
                            <icons:MaterialIcon Kind="ChevronDown" Width="16" Height="16" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Sync Curation Status with 'Picked' Folder"
                                          Command="{Binding SyncCurationStatusWithPickedFolderCommand}">
                                    <MenuItem.Icon>
                                        <icons:MaterialIcon Kind="FolderSyncOutline" Width="18" Height="18" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Synchronize Highlights"
                                          Command="{Binding SynchronizeHighlightsCommand}">
                                    <MenuItem.Icon>
                                        <icons:MaterialIcon Kind="StarOutline" Width="18" Height="18" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Create XMP files"
                                          Command="{Binding CreateXmpFilesCommand}">
                                    <MenuItem.Icon>
                                        <icons:MaterialIcon Kind="FileExportOutline" Width="18" Height="18" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Bulk Delete Tag Action -->
                    <Button Classes="Basic" ToolTip.Tip="Bulk Delete Tag from Album" IsVisible="{Binding IsShowingAlbum}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <icons:MaterialIcon Kind="TagMinus" Width="20" Height="20" Foreground="#FF5555" />
                            <icons:MaterialIcon Kind="ChevronDown" Width="14" Height="14" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft" Opened="BulkDeleteFlyout_Opened">
                                <Border Width="260" Padding="12" Background="{DynamicResource SukiCardBackground}" CornerRadius="8">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Bulk Delete Tag" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SukiText}" />
                                        <TextBlock Text="Select tag(s) to remove from all XMP files in this album:" FontSize="11" Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />

                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AlbumTagsForBulkDelete}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:BulkDeleteTagItemViewModel">
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding TagName}" FontWeight="SemiBold" Foreground="{DynamicResource SukiText}" />
                                                                <TextBlock Text="{Binding Count, StringFormat='({0})'}" Foreground="{DynamicResource SukiLowText}" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <TextBlock Text="No tags found in this album" IsVisible="{Binding !AlbumTagsForBulkDelete.Count}" Foreground="{DynamicResource SukiLowText}" FontStyle="Italic" FontSize="12" />

                                        <Button Classes="Accent" Command="{Binding ExecuteBulkDeleteTagsCommand}" IsEnabled="{Binding AlbumTagsForBulkDelete.Count}" HorizontalAlignment="Stretch" Height="34" Background="#CC3333">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <icons:MaterialIcon Kind="Delete" Width="16" Height="16" />
                                                <TextBlock Text="Delete Selected Tags" FontWeight="SemiBold" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" IsVisible="{Binding CanEditOrDeleteCurrentNode}">
                    <Button Classes="Basic" ToolTip.Tip="Edit"
                            Command="{Binding EditCurrentNodeCommand}">
                        <icons:MaterialIcon Kind="PencilOutline" Width="20" Height="20" />
                    </Button>

                    <Button Classes="Basic" ToolTip.Tip="Delete" Foreground="Red"
                            Command="{Binding DeleteCurrentNodeCommand}">
                        <icons:MaterialIcon Kind="DeleteOutline" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Panel Grid.Row="2">

            <!-- Empty State for Folders -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsShowingAlbum" />
                        <Binding Path="!Items.Count" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <icons:MaterialIcon Kind="FolderOpen" Width="64" Height="64" Foreground="{DynamicResource SukiLowText}" />
                <TextBlock Text="This folder is empty" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource SukiLowText}" />
            </StackPanel>

            <!-- Empty State for Albums -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsShowingAlbum" />
                        <Binding Path="!PicturesList.Count" />
                        <Binding Path="!IsLoading" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <icons:MaterialIcon Kind="ImageAlbum" Width="64" Height="64" Foreground="{DynamicResource SukiLowText}" />
                <TextBlock Text="This album is empty" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource SukiLowText}" />
            </StackPanel>


            <ScrollViewer IsVisible="{Binding !IsShowingAlbum}" Padding="20,10,20,20">
                <StackPanel Spacing="30">
                    <!-- Folders Section -->
                    <StackPanel Spacing="10" IsVisible="{Binding FolderItems.Count}">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="5,0">
                            <icons:MaterialIcon Kind="FolderOutline" Width="20" Height="20"
                                                Foreground="{DynamicResource SukiLowText}" />
                            <TextBlock Text="Folders" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SukiText}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding FolderItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="entities:Node">
                                    <Button Classes="Basic"
                                            Command="{Binding $parent[ItemsControl].((vm:GalleryViewModel)DataContext).NavigateToChildCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="10"
                                            Padding="0"
                                            CornerRadius="12"
                                            Cursor="Hand">
                                        <suki:GlassCard Width="160" Height="140">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Spacing="10">
                                                <Panel Width="48" Height="48">
                                                    <icons:MaterialIcon Kind="Folder"
                                                                        IsVisible="{Binding Type, Converter={StaticResource NodeTypeToBooleanConverter}, ConverterParameter=Folder}"
                                                                        Width="48" Height="48" Foreground="#FFD700" />
                                                    <icons:MaterialIcon Kind="ImageAlbum"
                                                                        IsVisible="{Binding Type, Converter={StaticResource NodeTypeToBooleanConverter}, ConverterParameter=Album}"
                                                                        Width="48" Height="48" Foreground="#87CEEB" />
                                                </Panel>
                                                <TextBlock Text="{Binding Name}"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SukiText}" />
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Albums Section -->
                    <StackPanel Spacing="10" IsVisible="{Binding AlbumItems.Count}">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="5,0">
                            <icons:MaterialIcon Kind="ImageAlbum" Width="20" Height="20"
                                                Foreground="{DynamicResource SukiLowText}" />
                            <TextBlock Text="Albums" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SukiText}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding AlbumItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="entities:Node">
                                    <Button Classes="Basic"
                                            Command="{Binding $parent[ItemsControl].((vm:GalleryViewModel)DataContext).NavigateToChildCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="10"
                                            Padding="0"
                                            CornerRadius="12"
                                            Cursor="Hand">
                                        <suki:GlassCard Width="160" Height="140">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Spacing="10">
                                                <Panel Width="48" Height="48">
                                                    <icons:MaterialIcon Kind="Folder"
                                                                        IsVisible="{Binding Type, Converter={StaticResource NodeTypeToBooleanConverter}, ConverterParameter=Folder}"
                                                                        Width="48" Height="48" Foreground="#FFD700" />
                                                    <icons:MaterialIcon Kind="ImageAlbum"
                                                                        IsVisible="{Binding Type, Converter={StaticResource NodeTypeToBooleanConverter}, ConverterParameter=Album}"
                                                                        Width="48" Height="48" Foreground="#87CEEB" />
                                                </Panel>
                                                <TextBlock Text="{Binding Name}"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SukiText}" />
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsShowingAlbum}" Padding="20,10,20,20">
                <ItemsControl x:Name="GroupedPicturesItemsControl" ItemsSource="{Binding GroupedPictures}"
                              Background="Transparent">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PictureGroupViewModel">
                            <StackPanel Spacing="10" Margin="0,0,0,30">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="5,0">
                                    <icons:MaterialIcon Kind="BurstMode"
                                                        IsVisible="{Binding IsBurstGroup}"
                                                        Width="20" Height="20"
                                                        Foreground="{DynamicResource SukiPrimaryColor}" />
                                    <icons:MaterialIcon Kind="CalendarToday"
                                                        IsVisible="{Binding !IsBurstGroup}"
                                                        Width="20" Height="20"
                                                        Foreground="{DynamicResource SukiLowText}" />
                                    <TextBlock Text="{Binding Header}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SukiText}" />
                                </StackPanel>

                                <ItemsControl x:Name="GroupPicturesItemsControl"
                                              ItemsSource="{Binding Pictures}"
                                              Background="Transparent">
                                    <ItemsControl.Styles>
                                        <Style Selector="Border.selected">
                                            <Setter Property="BorderBrush" Value="#0078FF" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PictureItemViewModel">
                                            <controls:AspectRatioPanel Width="320" Ratio="0.85" Margin="8">
                                                <!-- The 'Matted Print' Border -->
                                                <Border Name="PART_AspectBorder"
                                                        Classes.selected="{Binding IsSelected}"
                                                        Background="#1C232E"
                                                        BorderBrush="#3A4454"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ClipToBounds="True">
                                                    <Grid RowDefinitions="*,Auto">
                                                        <!-- Color Label Background Overlay -->
                                                        <Border Grid.RowSpan="2"
                                                                Background="{Binding ColorLabel, Converter={StaticResource ColorLabelToBrushConverter}}"
                                                                Opacity="0.18" />

                                                        <Panel Grid.Row="0" Margin="8">
                                                            <!-- Placeholder Fallback Border/Icon -->
                                                            <Border Background="#1A222D"
                                                                    BorderBrush="#2C3545"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                                                <icons:MaterialIcon Kind="ImageOutline"
                                                                                    Width="48"
                                                                                    Height="48"
                                                                                    Foreground="#3E4B5E"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" />
                                                            </Border>

                                                            <Image Source="{Binding Thumbnail}"
                                                                   Classes.loaded="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   EffectiveViewportChanged="OnImageEffectiveViewportChanged"
                                                                   DataContextChanged="OnImageDataContextChanged">
                                                                <Image.Transitions>
                                                                    <Transitions>
                                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                                                                    </Transitions>
                                                                </Image.Transitions>
                                                                <Image.Styles>
                                                                    <Style Selector="Image">
                                                                        <Setter Property="Opacity" Value="0" />
                                                                    </Style>
                                                                    <Style Selector="Image.loaded">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </Style>
                                                                </Image.Styles>
                                                            </Image>

                                                            <!-- Top Left: Flagged Indicator -->
                                                            <Border VerticalAlignment="Top"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="4"
                                                                    Padding="4"
                                                                    CornerRadius="4"
                                                                    Background="#80000000"
                                                                    IsVisible="{Binding CurationStatus, Converter={StaticResource CurationStatusToBooleanConverter}, ConverterParameter=Flagged}">
                                                                <icons:MaterialIcon Kind="Flag"
                                                                        Width="16" Height="16"
                                                                        Foreground="#4CAF50" />
                                                            </Border>
                                                        </Panel>

                                                        <!-- Metadata Section with CheckBox -->
                                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="8,4,8,8" VerticalAlignment="Center">
                                                            <!-- Bottom-Left CheckBox -->
                                                            <CheckBox Grid.Column="0"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left"
                                                                      Margin="0,0,6,0"
                                                                      Padding="0"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      IsHitTestVisible="True"
                                                                      Focusable="False"
                                                                      Cursor="Hand" />

                                                            <!-- Centered Stars + Filename -->
                                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                                <!-- Rating Indicator -->
                                                                <StackPanel HorizontalAlignment="Center"
                                                                        Orientation="Horizontal"
                                                                        Spacing="1">
                                                                    <Panel>
                                                                        <icons:MaterialIcon Kind="StarOutline"
                                                                                Width="10" Height="10"
                                                                                Foreground="Gray" Opacity="0.5"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!1}" />
                                                                        <icons:MaterialIcon Kind="Star" Width="10"
                                                                                Height="10" Foreground="Gold"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=1}" />
                                                                    </Panel>
                                                                    <Panel>
                                                                        <icons:MaterialIcon Kind="StarOutline"
                                                                                Width="10" Height="10"
                                                                                Foreground="Gray" Opacity="0.5"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!2}" />
                                                                        <icons:MaterialIcon Kind="Star" Width="10"
                                                                                Height="10" Foreground="Gold"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=2}" />
                                                                    </Panel>
                                                                    <Panel>
                                                                        <icons:MaterialIcon Kind="StarOutline"
                                                                                Width="10" Height="10"
                                                                                Foreground="Gray" Opacity="0.5"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!3}" />
                                                                        <icons:MaterialIcon Kind="Star" Width="10"
                                                                                Height="10" Foreground="Gold"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=3}" />
                                                                    </Panel>
                                                                    <Panel>
                                                                        <icons:MaterialIcon Kind="StarOutline"
                                                                                Width="10" Height="10"
                                                                                Foreground="Gray" Opacity="0.5"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!4}" />
                                                                        <icons:MaterialIcon Kind="Star" Width="10"
                                                                                Height="10" Foreground="Gold"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=4}" />
                                                                    </Panel>
                                                                    <Panel>
                                                                        <icons:MaterialIcon Kind="StarOutline"
                                                                                Width="10" Height="10"
                                                                                Foreground="Gray" Opacity="0.5"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!5}" />
                                                                        <icons:MaterialIcon Kind="Star" Width="10"
                                                                                Height="10" Foreground="Gold"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=5}" />
                                                                    </Panel>
                                                                </StackPanel>

                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                                <!-- Selection Indicator overlay (Blue) -->
                                                <Border Name="SelectionIndicator"
                                                        BorderBrush="#0078FF"
                                                        BorderThickness="2"
                                                        CornerRadius="4"
                                                        IsHitTestVisible="False"
                                                        IsVisible="{Binding IsSelected}"
                                                        ZIndex="10" />
                                            </controls:AspectRatioPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Panel>
    </Grid>

</UserControl>
