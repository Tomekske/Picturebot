<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Picturebot.ViewModels;assembly=Picturebot"
             xmlns:entities="using:Database.Domain.Entities"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:converters="using:Picturebot.Converters"
             xmlns:controls="using:Picturebot.Controls"
             xmlns:enums="using:Domain.Enums"
             xmlns:labs="clr-namespace:Avalonia.Labs.Panels;assembly=Avalonia.Labs.Panels"
             xmlns:views="using:Picturebot.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Picturebot.Views.GalleryView"
             x:DataType="vm:GalleryViewModel">

    

    <UserControl.Resources>
        <converters:NodeTypeToBooleanConverter x:Key="NodeTypeToBooleanConverter" />
        <converters:CurationStatusToBooleanConverter x:Key="CurationStatusToBooleanConverter" />
        <converters:ColorLabelToBrushConverter x:Key="ColorLabelToBrushConverter" />
        <converters:RatingToBooleanConverter x:Key="RatingToBooleanConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- ── Header: breadcrumb (current album/folder as title), stats and actions ── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,4,20,12">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="TextBlock.crumb">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                        </Style>
                        <Style Selector="TextBlock.crumb.current">
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BreadcrumbItem">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="Basic"
                                        Padding="4,2"
                                        Command="{Binding $parent[ItemsControl].((vm:GalleryViewModel)DataContext).NavigateToBreadcrumbCommand}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand">
                                    <TextBlock Classes="crumb" Classes.current="{Binding IsLast}" Text="{Binding Name}" />
                                </Button>
                                <icons:MaterialIcon Kind="ChevronRight"
                                                    IsVisible="{Binding !IsLast}"
                                                    VerticalAlignment="Center"
                                                    Width="16" Height="16"
                                                    Foreground="{DynamicResource Text.Muted}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding AlbumStatsText}"
                           IsVisible="{Binding IsShowingAlbum}"
                           FontSize="12"
                           Margin="4,0,0,0"
                           Foreground="{DynamicResource Text.Muted}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="Secondary"
                        IsVisible="{Binding IsShowingAlbum}"
                        Command="{Binding AiCurateBurstCommand}"
                        ToolTip.Tip="Compare the selected pictures with Gemini and suggest the best one">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="Creation" Width="16" Height="16" Foreground="{DynamicResource Accent.Foreground}" />
                        <TextBlock Text="AI Curate" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="Primary"
                        IsVisible="{Binding IsShowingAlbum}"
                        Command="{Binding PlayCarouselCommand}"
                        ToolTip.Tip="Slideshow">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="Play" Width="16" Height="16" />
                        <TextBlock Text="Slideshow" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="Secondary" Padding="10,8" ToolTip.Tip="More actions">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="IsShowingAlbum" />
                            <Binding Path="CanEditOrDeleteCurrentNode" />
                        </MultiBinding>
                    </Button.IsVisible>
                    <icons:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Open folder in Explorer" Command="{Binding OpenInExplorerCommand}" IsVisible="{Binding IsShowingAlbum}">
                                <MenuItem.Icon><icons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Open in DxO PhotoLab" Command="{Binding OpenInDxoCommand}" IsVisible="{Binding IsShowingAlbum}">
                                <MenuItem.Icon><icons:MaterialIcon Kind="OpenInApp" Width="16" Height="16" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator IsVisible="{Binding IsShowingAlbum}" />
                            <MenuItem Header="Sync status with Picked folder" Command="{Binding SyncCurationStatusWithPickedFolderCommand}" IsVisible="{Binding IsShowingAlbum}">
                                <MenuItem.Icon><icons:MaterialIcon Kind="FolderSyncOutline" Width="16" Height="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Sync highlights" Command="{Binding SynchronizeHighlightsCommand}" IsVisible="{Binding IsShowingAlbum}">
                                <MenuItem.Icon><icons:MaterialIcon Kind="StarOutline" Width="16" Height="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Create XMP files" Command="{Binding CreateXmpFilesCommand}" IsVisible="{Binding IsShowingAlbum}">
                                <MenuItem.Icon><icons:MaterialIcon Kind="FileExportOutline" Width="16" Height="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Remove tags from album…" Command="{Binding OpenBulkRemoveTagsDialogCommand}" IsVisible="{Binding IsShowingAlbum}">
                                <MenuItem.Icon><icons:MaterialIcon Kind="TagMinus" Width="16" Height="16" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator IsVisible="{Binding CanEditOrDeleteCurrentNode}" />
                            <MenuItem Header="Edit…" Command="{Binding EditCurrentNodeCommand}" IsVisible="{Binding CanEditOrDeleteCurrentNode}">
                                <MenuItem.Icon><icons:MaterialIcon Kind="PencilOutline" Width="16" Height="16" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Delete…" Command="{Binding DeleteCurrentNodeCommand}" IsVisible="{Binding CanEditOrDeleteCurrentNode}"
                                      Foreground="{DynamicResource Status.Danger}">
                                <MenuItem.Icon><icons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="{DynamicResource Status.Danger}" /></MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── View and filter bar (albums and search results) ── -->
        <Border Grid.Row="1"
                IsVisible="{Binding IsShowingAlbum}"
                Margin="20,0,20,8"
                Padding="8,6"
                Background="{DynamicResource Surface.Panel}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Dialog}">
            <Border.Styles>
                <Style Selector="Button.segment">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="5" />
                    <Setter Property="Padding" Value="10,4" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
                <Style Selector="Button.segment:pointerover">
                    <Setter Property="Background" Value="{DynamicResource State.Hover}" />
                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                </Style>
                <Style Selector="Button.segment.active, Button.segment.active:pointerover">
                    <Setter Property="Background" Value="{DynamicResource Accent.Selected}" />
                    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
                </Style>
                <Style Selector="Rectangle.bar-divider">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Height" Value="18" />
                    <Setter Property="Fill" Value="{DynamicResource Border.Subtle}" />
                    <Setter Property="Margin" Value="6,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Border.Styles>
            <!-- WrapPanel: on narrow windows the bar wraps to a second line instead of overlapping -->
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Grouping -->
                <Border Background="{DynamicResource Surface.Card}" CornerRadius="{DynamicResource Radius.Control}" Padding="2" VerticalAlignment="Center" Margin="0,2">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="segment" Classes.active="{Binding !IsBurstViewEnabled}"
                                Command="{Binding SetGroupingModeCommand}" CommandParameter="Date"
                                ToolTip.Tip="Group by capture date">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:MaterialIcon Kind="CalendarMonthOutline" Width="14" Height="14" />
                                <TextBlock Text="Date" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="segment" Classes.active="{Binding IsBurstViewEnabled}"
                                Command="{Binding SetGroupingModeCommand}" CommandParameter="Burst"
                                IsEnabled="{Binding !IsGlobalSearchActive}"
                                ToolTip.Tip="Group bursts of similar shots">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:MaterialIcon Kind="LayersOutline" Width="14" Height="14" />
                                <TextBlock Text="Burst" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Button Classes="Basic"
                        IsVisible="{Binding IsBurstViewEnabled}"
                        Command="{Binding AutoFlagBestPicturesCommand}"
                        Padding="8,4"
                        Margin="4,2,0,2"
                        ToolTip.Tip="Pick the sharpest shot of every burst">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <icons:MaterialIcon Kind="AutoFix" Width="14" Height="14" Foreground="{DynamicResource Accent.Foreground}" />
                        <TextBlock Text="Pick best in bursts" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Sort -->
                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                          MinWidth="130"
                          Margin="8,2,0,2"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Sort pictures within each group">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GallerySortOption">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="SortVariant" Width="14" Height="14" Foreground="{DynamicResource Text.Secondary}" />
                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Rectangle Classes="bar-divider" />

                <!-- Filters -->
                <views:FilterToolbarView DataContext="{Binding FilterToolbar}" VerticalAlignment="Center" Margin="0,2" />
            </WrapPanel>
        </Border>

        <!-- ── Active filter pills and result count ── -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="22,0,22,10" IsVisible="{Binding IsShowingAlbum}">
            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding FilterToolbar.ActivePills}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActiveFilterPill">
                            <Border Background="{DynamicResource Accent.Subtle}" CornerRadius="12" Padding="10,3,4,3" Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" />
                                    <Button Classes="Basic" Padding="2" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove filter">
                                        <icons:MaterialIcon Kind="Close" Width="12" Height="12" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="Basic"
                        IsVisible="{Binding FilterToolbar.HasActivePills}"
                        Command="{Binding FilterToolbar.ClearAllCommand}"
                        Padding="6,3"
                        Margin="0,0,0,4"
                        ToolTip.Tip="Clear all filters (Shift+R)">
                    <TextBlock Text="Clear all" FontSize="12" Foreground="{DynamicResource Accent.Foreground}" />
                </Button>
            </WrapPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding ResultCountText}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}" />
        </Grid>

        <Panel Grid.Row="3">

            <!-- Empty State for Folders -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsShowingAlbum" />
                        <Binding Path="!Items.Count" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <icons:MaterialIcon Kind="FolderOpen" Width="64" Height="64" Foreground="{DynamicResource SukiLowText}" />
                <TextBlock Text="This folder is empty" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource SukiLowText}" />
            </StackPanel>

            <!-- Empty State for Albums -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <StackPanel.IsVisible>
                    <Binding Path="IsAlbumEmpty" />
                </StackPanel.IsVisible>
                <icons:MaterialIcon Kind="ImageAlbum" Width="64" Height="64" Foreground="{DynamicResource SukiLowText}" />
                <TextBlock Text="This album is empty" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource SukiLowText}" />
            </StackPanel>


            <!-- Empty State: filters hide every picture -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        IsVisible="{Binding IsFilteredEmpty}">
                <icons:MaterialIcon Kind="FilterOffOutline" Width="56" Height="56" Foreground="{DynamicResource Text.Muted}" />
                <TextBlock Text="No pictures match these filters" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
                <Button Classes="Secondary" Content="Clear filters" HorizontalAlignment="Center"
                        Command="{Binding FilterToolbar.ClearAllCommand}" />
            </StackPanel>

            <ScrollViewer IsVisible="{Binding !IsShowingAlbum}" Padding="20,10,20,20">
                <StackPanel Spacing="30">
                    <!-- Folders Section -->
                    <StackPanel Spacing="10" IsVisible="{Binding FolderItems.Count}">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="5,0">
                            <icons:MaterialIcon Kind="FolderOutline" Width="20" Height="20"
                                                Foreground="{DynamicResource SukiLowText}" />
                            <TextBlock Text="Folders" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SukiText}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding FolderItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="entities:Node">
                                    <Button Classes="Basic"
                                            Command="{Binding $parent[ItemsControl].((vm:GalleryViewModel)DataContext).NavigateToChildCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="10"
                                            Padding="0"
                                            CornerRadius="12"
                                            Cursor="Hand">
                                        <suki:GlassCard Width="160" Height="140">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Spacing="10">
                                                <Panel Width="48" Height="48">
                                                    <icons:MaterialIcon Kind="Folder"
                                                                        IsVisible="{Binding Type, Converter={StaticResource NodeTypeToBooleanConverter}, ConverterParameter=Folder}"
                                                                        Width="48" Height="48" Foreground="{DynamicResource Icon.Folder}" />
                                                    <icons:MaterialIcon Kind="ImageAlbum"
                                                                        IsVisible="{Binding Type, Converter={StaticResource NodeTypeToBooleanConverter}, ConverterParameter=Album}"
                                                                        Width="48" Height="48" Foreground="{DynamicResource Icon.Album}" />
                                                </Panel>
                                                <TextBlock Text="{Binding Name}"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SukiText}" />
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Albums Section -->
                    <StackPanel Spacing="10" IsVisible="{Binding AlbumItems.Count}">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="5,0">
                            <icons:MaterialIcon Kind="ImageAlbum" Width="20" Height="20"
                                                Foreground="{DynamicResource SukiLowText}" />
                            <TextBlock Text="Albums" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SukiText}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding AlbumItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="entities:Node">
                                    <Button Classes="Basic"
                                            Command="{Binding $parent[ItemsControl].((vm:GalleryViewModel)DataContext).NavigateToChildCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="10"
                                            Padding="0"
                                            CornerRadius="12"
                                            Cursor="Hand">
                                        <suki:GlassCard Width="160" Height="140">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Spacing="10">
                                                <Panel Width="48" Height="48">
                                                    <icons:MaterialIcon Kind="Folder"
                                                                        IsVisible="{Binding Type, Converter={StaticResource NodeTypeToBooleanConverter}, ConverterParameter=Folder}"
                                                                        Width="48" Height="48" Foreground="{DynamicResource Icon.Folder}" />
                                                    <icons:MaterialIcon Kind="ImageAlbum"
                                                                        IsVisible="{Binding Type, Converter={StaticResource NodeTypeToBooleanConverter}, ConverterParameter=Album}"
                                                                        Width="48" Height="48" Foreground="{DynamicResource Icon.Album}" />
                                                </Panel>
                                                <TextBlock Text="{Binding Name}"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SukiText}" />
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Spacing lives on the content (not ScrollViewer.Padding) so the grid width matches the clip area -->
            <ScrollViewer IsVisible="{Binding IsShowingAlbum}" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GroupedPicturesItemsControl" ItemsSource="{Binding GroupedPictures}"
                              Margin="20,10,24,20"
                              Background="Transparent">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PictureGroupViewModel">
                            <StackPanel Spacing="14" Margin="0,0,0,32">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <icons:MaterialIcon Kind="BurstMode"
                                                        IsVisible="{Binding IsBurstGroup}"
                                                        Width="20" Height="20"
                                                        Foreground="{DynamicResource Accent.Foreground}" />
                                    <icons:MaterialIcon Kind="CalendarToday"
                                                        IsVisible="{Binding !IsBurstGroup}"
                                                        Width="20" Height="20"
                                                        Foreground="{DynamicResource SukiLowText}" />
                                    <TextBlock Text="{Binding Header}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SukiText}" />
                                </StackPanel>

                                <ItemsControl x:Name="GroupPicturesItemsControl"
                                              ItemsSource="{Binding Pictures}"
                                              Background="Transparent">
                                    <ItemsControl.Styles>
                                        <!-- Rejected pictures are dimmed so pressing X gives instant feedback -->
                                        <Style Selector="Border.rejected">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <!-- Fills the row: as many columns as fit at MinItemWidth, cards stretched equally -->
                                            <controls:AdaptiveGridPanel MinItemWidth="260" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PictureItemViewModel">
                                            <Panel>
                                                <!-- The 'Matted Print' Border -->
                                                <Border Name="PART_AspectBorder"
                                                        Classes.rejected="{Binding CurationStatus, Converter={StaticResource CurationStatusToBooleanConverter}, ConverterParameter=Rejected}"
                                                        Background="{DynamicResource Surface.Card}"
                                                        BorderBrush="{DynamicResource Border.Subtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ClipToBounds="True">
                                                    <Grid RowDefinitions="Auto,Auto">
                                                        <!-- Color Label Background Overlay -->
                                                        <Border Grid.RowSpan="2"
                                                                Background="{Binding ColorLabel, Converter={StaticResource ColorLabelToBrushConverter}}"
                                                                Opacity="0.18" />

                                                        <!-- Photo area is fixed at 3:2 (the camera's native shape), so landscape shots fill it with no
                                                             letterbox bands; other shapes leave space that blends into the card. -->
                                                        <controls:AspectRatioPanel Grid.Row="0" Margin="8" Ratio="0.6667">
                                                            <!-- Placeholder Fallback Border/Icon -->
                                                            <Border Background="{DynamicResource Photo.Backdrop}"
                                                                    BorderBrush="{DynamicResource Border.Subtle}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                                                <icons:MaterialIcon Kind="ImageOutline"
                                                                                    Width="48"
                                                                                    Height="48"
                                                                                    Foreground="{DynamicResource Photo.Placeholder}"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" />
                                                            </Border>

                                                            <Image Source="{Binding Thumbnail}"
                                                                   Classes.loaded="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   EffectiveViewportChanged="OnImageEffectiveViewportChanged"
                                                                   DataContextChanged="OnImageDataContextChanged">
                                                                <Image.Transitions>
                                                                    <Transitions>
                                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                                                                    </Transitions>
                                                                </Image.Transitions>
                                                                <Image.Styles>
                                                                    <Style Selector="Image">
                                                                        <Setter Property="Opacity" Value="0" />
                                                                    </Style>
                                                                    <Style Selector="Image.loaded">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </Style>
                                                                </Image.Styles>
                                                            </Image>

                                                            <!-- Top Left: Flagged Indicator -->
                                                            <Border VerticalAlignment="Top"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="4"
                                                                    Padding="4"
                                                                    CornerRadius="4"
                                                                    Background="{DynamicResource Surface.Overlay}"
                                                                    IsVisible="{Binding CurationStatus, Converter={StaticResource CurationStatusToBooleanConverter}, ConverterParameter=Flagged}">
                                                                <icons:MaterialIcon Kind="Flag"
                                                                        Width="16" Height="16"
                                                                        Foreground="{DynamicResource Status.Picked}" />
                                                             </Border>

                                                            <!-- Top Right: Best Pick / AI Indicator -->
                                                            <Border VerticalAlignment="Top"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="4"
                                                                    Padding="4,2"
                                                                    CornerRadius="4"
                                                                    Background="{DynamicResource Surface.Overlay}"
                                                                    ToolTip.Tip="{Binding AiFeedback}"
                                                                    IsVisible="{Binding IsBest}">
                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                    <icons:MaterialIcon Kind="Star"
                                                                            Width="12" Height="12"
                                                                            Foreground="{DynamicResource Status.Rating}" />
                                                                    <TextBlock Text="BEST" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Status.Rating}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </controls:AspectRatioPanel>

                                                        <!-- Metadata Section with CheckBox -->
                                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="8,4,8,8" VerticalAlignment="Center">
                                                            <!-- Bottom-Left CheckBox -->
                                                            <CheckBox Grid.Column="0"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left"
                                                                      Margin="0,0,6,0"
                                                                      Padding="0"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      IsHitTestVisible="True"
                                                                      Focusable="False"
                                                                      Cursor="Hand" />

                                                            <!-- Centered Stars + Filename -->
                                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                                <!-- Rating Indicator -->
                                                                <StackPanel HorizontalAlignment="Center"
                                                                        Orientation="Horizontal"
                                                                        Spacing="1">
                                                                    <Panel>
                                                                        <icons:MaterialIcon Kind="StarOutline"
                                                                                Width="10" Height="10"
                                                                                Foreground="{DynamicResource Text.Muted}" Opacity="0.5"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!1}" />
                                                                        <icons:MaterialIcon Kind="Star" Width="10"
                                                                                Height="10" Foreground="{DynamicResource Status.Rating}"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=1}" />
                                                                    </Panel>
                                                                    <Panel>
                                                                        <icons:MaterialIcon Kind="StarOutline"
                                                                                Width="10" Height="10"
                                                                                Foreground="{DynamicResource Text.Muted}" Opacity="0.5"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!2}" />
                                                                        <icons:MaterialIcon Kind="Star" Width="10"
                                                                                Height="10" Foreground="{DynamicResource Status.Rating}"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=2}" />
                                                                    </Panel>
                                                                    <Panel>
                                                                        <icons:MaterialIcon Kind="StarOutline"
                                                                                Width="10" Height="10"
                                                                                Foreground="{DynamicResource Text.Muted}" Opacity="0.5"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!3}" />
                                                                        <icons:MaterialIcon Kind="Star" Width="10"
                                                                                Height="10" Foreground="{DynamicResource Status.Rating}"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=3}" />
                                                                    </Panel>
                                                                    <Panel>
                                                                        <icons:MaterialIcon Kind="StarOutline"
                                                                                Width="10" Height="10"
                                                                                Foreground="{DynamicResource Text.Muted}" Opacity="0.5"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!4}" />
                                                                        <icons:MaterialIcon Kind="Star" Width="10"
                                                                                Height="10" Foreground="{DynamicResource Status.Rating}"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=4}" />
                                                                    </Panel>
                                                                    <Panel>
                                                                        <icons:MaterialIcon Kind="StarOutline"
                                                                                Width="10" Height="10"
                                                                                Foreground="{DynamicResource Text.Muted}" Opacity="0.5"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=!5}" />
                                                                        <icons:MaterialIcon Kind="Star" Width="10"
                                                                                Height="10" Foreground="{DynamicResource Status.Rating}"
                                                                                IsVisible="{Binding Rating, Converter={StaticResource RatingToBooleanConverter}, ConverterParameter=5}" />
                                                                    </Panel>
                                                                </StackPanel>

                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Text.Primary}"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                                <!-- Selection Indicator overlay (Blue) -->
                                                <Border Name="SelectionIndicator"
                                                        BorderBrush="{DynamicResource Accent.Foreground}"
                                                        BorderThickness="2"
                                                        CornerRadius="4"
                                                        IsHitTestVisible="False"
                                                        IsVisible="{Binding IsSelected}"
                                                        ZIndex="10" />
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Panel>
    </Grid>

</UserControl>
