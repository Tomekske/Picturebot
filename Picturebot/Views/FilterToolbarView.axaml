<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Picturebot.ViewModels"
             xmlns:converters="using:Picturebot.Converters"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="40"
             x:Class="Picturebot.Views.FilterToolbarView"
             x:DataType="vm:FilterToolbarViewModel">

    <UserControl.Resources>
        <converters:RatingToBrushConverter x:Key="RatingToBrush" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Base Style for Filter ToggleButtons (Chips) -->
        <Style Selector="ToggleButton.FilterChip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Rating filter stars -->
        <Style Selector="Button.RatingStar">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Color dot chips are narrower than the icon chips -->
        <Style Selector="ToggleButton.DotChip">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>

        <!-- Template Override for Hover and Checked transitions -->
        <Style Selector="ToggleButton.FilterChip /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Hover State -->
        <Style Selector="ToggleButton.FilterChip:pointerover">
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Background" Value="{DynamicResource State.Hover}"/>
        </Style>

        <!-- Active/Selected State -->
        <Style Selector="ToggleButton.FilterChip:checked">
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Background" Value="{DynamicResource State.Active}"/>
        </Style>

        <!-- Active and Hovered State -->
        <Style Selector="ToggleButton.FilterChip:checked:pointerover">
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Background" Value="{DynamicResource State.ActiveHover}"/>
        </Style>

        <!-- Specialized Style for Stars (since they have wider content) -->
        <Style Selector="ToggleButton.StarChip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.StarChip /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="ToggleButton.StarChip:pointerover">
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Background" Value="{DynamicResource State.Hover}"/>
        </Style>

        <Style Selector="ToggleButton.StarChip:checked">
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Background" Value="{DynamicResource State.Active}"/>
        </Style>

        <Style Selector="ToggleButton.StarChip:checked:pointerover">
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Background" Value="{DynamicResource State.ActiveHover}"/>
        </Style>

        <!-- Dynamic Icon Fills depending on state -->
        <!-- Picked Flag (Green when active) -->
        <Style Selector="ToggleButton.PickedFlag Path">
            <Setter Property="Fill" Value="{DynamicResource Text.Primary}" />
        </Style>
        <Style Selector="ToggleButton.PickedFlag:checked Path">
            <Setter Property="Fill" Value="{DynamicResource Status.Picked}" />
        </Style>

        <!-- Neutral Flag (Neutral Grey when active) -->
        <Style Selector="ToggleButton.NeutralFlag Path">
            <Setter Property="Fill" Value="{DynamicResource Text.Primary}" />
        </Style>
        <Style Selector="ToggleButton.NeutralFlag:checked Path">
            <Setter Property="Fill" Value="{DynamicResource Text.Muted}" />
        </Style>

        <!-- Rejected Flag (Red when active) -->
        <Style Selector="ToggleButton.RejectedFlag Path">
            <Setter Property="Fill" Value="{DynamicResource Text.Primary}" />
        </Style>
        <Style Selector="ToggleButton.RejectedFlag:checked Path">
            <Setter Property="Fill" Value="{DynamicResource Status.Danger}" />
        </Style>

        <!-- Rating Stars (Gold when active) -->
        <Style Selector="ToggleButton.StarChip Path">
            <Setter Property="Fill" Value="{DynamicResource Text.Primary}" />
        </Style>
        <Style Selector="ToggleButton.StarChip:checked Path">
            <Setter Property="Fill" Value="{DynamicResource Status.Rating}" />
        </Style>
        <Style Selector="ToggleButton.StarChip icons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        </Style>
        <Style Selector="ToggleButton.StarChip:checked icons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource Status.Rating}" />
        </Style>
        <Style Selector="ToggleButton.StarChip:checked TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Status.Rating}" />
        </Style>

        <Style Selector="Button.ResetBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ResetBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="Button.ResetBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource State.Hover}"/>
        </Style>

        <Style Selector="Button.ResetBtn:pointerover icons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
        <!-- Curation Status Group -->
        <StackPanel Orientation="Horizontal" Spacing="2">
            <!-- Picked Flag -->
            <ToggleButton Classes="FilterChip PickedFlag" 
                          IsChecked="{Binding IsFlaggedActive}"
                          ToolTip.Tip="Filter Picked (Shift+P)">
                <Path Data="M14.4,6L14,4H5V21H7V14H12.6L13,16H20V6H14.4Z" 
                      Width="14" Height="14" Stretch="Uniform"/>
            </ToggleButton>

            <!-- Neutral Flag -->
            <ToggleButton Classes="FilterChip NeutralFlag" 
                          IsChecked="{Binding IsNeutralActive}"
                          ToolTip.Tip="Filter Neutral / Unflagged">
                <Path Data="M12.6,12H7V6H14.4L14.8,8H19V12H14.4L14,10H7V12H12.6M14,4H5V21H7V14H12.6L13,16H20V6H14.4L14,4Z" 
                      Width="14" Height="14" Stretch="Uniform"/>
            </ToggleButton>

            <!-- Rejected Flag -->
            <ToggleButton Classes="FilterChip RejectedFlag" 
                          IsChecked="{Binding IsRejectedActive}"
                          ToolTip.Tip="Filter Rejected">
                <Path Data="M12,2C6.47,2 2,6.47 2,12s4.47,10 10,10s10-4.47 10-10S17.53,2 12,2z M12,20c-4.42,0-8-3.58-8-8c0-1.85,0.63-3.55,1.69-4.9L16.9,18.31C15.55,19.37 13.85,20 12,20z M18.31,16.9L7.1,5.69C8.45,4.63 10.15,4 12,4c4.42,0 8,3.58 8,8C20,13.85 19.37,15.55 18.31,16.9z" 
                      Width="14" Height="14" Stretch="Uniform"/>
            </ToggleButton>
        </StackPanel>

        <!-- Vertical Separator -->
        <Separator Width="1" Height="14" Background="{DynamicResource Border.Subtle}" Margin="6,0" VerticalAlignment="Center"/>

        <!-- Rating filter: five stars, click star N for "N stars or more", click again to clear -->
        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
            <Button Classes="Basic RatingStar" Command="{Binding ToggleMinRatingCommand}" CommandParameter="1"
                    ToolTip.Tip="1 star or more (click again to clear)">
                <icons:MaterialIcon Kind="Star" Width="15" Height="15"
                                    Foreground="{Binding ActiveMinRating, Converter={StaticResource RatingToBrush}, ConverterParameter=1}" />
            </Button>
            <Button Classes="Basic RatingStar" Command="{Binding ToggleMinRatingCommand}" CommandParameter="2"
                    ToolTip.Tip="2 stars or more (click again to clear)">
                <icons:MaterialIcon Kind="Star" Width="15" Height="15"
                                    Foreground="{Binding ActiveMinRating, Converter={StaticResource RatingToBrush}, ConverterParameter=2}" />
            </Button>
            <Button Classes="Basic RatingStar" Command="{Binding ToggleMinRatingCommand}" CommandParameter="3"
                    ToolTip.Tip="3 stars or more (click again to clear)">
                <icons:MaterialIcon Kind="Star" Width="15" Height="15"
                                    Foreground="{Binding ActiveMinRating, Converter={StaticResource RatingToBrush}, ConverterParameter=3}" />
            </Button>
            <Button Classes="Basic RatingStar" Command="{Binding ToggleMinRatingCommand}" CommandParameter="4"
                    ToolTip.Tip="4 stars or more (click again to clear)">
                <icons:MaterialIcon Kind="Star" Width="15" Height="15"
                                    Foreground="{Binding ActiveMinRating, Converter={StaticResource RatingToBrush}, ConverterParameter=4}" />
            </Button>
            <Button Classes="Basic RatingStar" Command="{Binding ToggleMinRatingCommand}" CommandParameter="5"
                    ToolTip.Tip="5 stars (click again to clear)">
                <icons:MaterialIcon Kind="Star" Width="15" Height="15"
                                    Foreground="{Binding ActiveMinRating, Converter={StaticResource RatingToBrush}, ConverterParameter=5}" />
            </Button>
        </StackPanel>

        <!-- Vertical Separator -->
        <Separator Width="1" Height="14" Background="{DynamicResource Border.Subtle}" Margin="6,0" VerticalAlignment="Center"/>

        <!-- Color Label Chips Group (same order as the Details panel) -->
        <StackPanel Orientation="Horizontal" Spacing="0">
            <ToggleButton Classes="FilterChip DotChip"
                          IsChecked="{Binding IsRedActive}"
                          ToolTip.Tip="Red label">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Label.Red}"/>
            </ToggleButton>
            <ToggleButton Classes="FilterChip DotChip"
                          IsChecked="{Binding IsOrangeActive}"
                          ToolTip.Tip="Orange label">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Label.Orange}"/>
            </ToggleButton>
            <ToggleButton Classes="FilterChip DotChip"
                          IsChecked="{Binding IsYellowActive}"
                          ToolTip.Tip="Yellow label">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Label.Yellow}"/>
            </ToggleButton>
            <ToggleButton Classes="FilterChip DotChip"
                          IsChecked="{Binding IsGreenActive}"
                          ToolTip.Tip="Green label">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Label.Green}"/>
            </ToggleButton>
            <ToggleButton Classes="FilterChip DotChip"
                          IsChecked="{Binding IsBlueActive}"
                          ToolTip.Tip="Blue label">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Label.Blue}"/>
            </ToggleButton>
            <ToggleButton Classes="FilterChip DotChip"
                          IsChecked="{Binding IsPinkActive}"
                          ToolTip.Tip="Pink label">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Label.Pink}"/>
            </ToggleButton>
            <ToggleButton Classes="FilterChip DotChip"
                          IsChecked="{Binding IsPurpleActive}"
                          ToolTip.Tip="Purple label">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Label.Purple}"/>
            </ToggleButton>
            <ToggleButton Classes="FilterChip DotChip"
                          IsChecked="{Binding IsNoneActive}"
                          ToolTip.Tip="No label">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Label.None}"/>
            </ToggleButton>
        </StackPanel>

        <!-- Vertical Separator -->
        <Separator Width="1" Height="14" Background="{DynamicResource Border.Subtle}" Margin="6,0" VerticalAlignment="Center"/>

        <!-- Tags Dropdown Button -->
        <Button Classes.primary="{Binding IsTagFilterActive}"
                Height="24"
                CornerRadius="12"
                Padding="8,0"
                Margin="1,0"
                Cursor="Hand"
                VerticalAlignment="Center">
            <Button.Styles>
                <Style Selector="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
                <Style Selector="Button.primary">
                    <Setter Property="Background" Value="{DynamicResource Accent.Fill}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </Button.Styles>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <!-- Tag Icon -->
                <Path Data="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 8.25c-.69 0-1.25-.56-1.25-1.25s.56-1.25 1.25-1.25 1.25.56 1.25 1.25-.56 1.25-1.25 1.25z" 
                      Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                <TextBlock Text="Tags" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                <TextBlock Text="{Binding ActiveTagFiltersCountText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}" IsVisible="{Binding IsTagFilterActive}"/>
                <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
            </StackPanel>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                    <Border x:DataType="vm:FilterToolbarViewModel" Width="290" Padding="8">
                        <StackPanel Spacing="10">
                            <!-- Search query TextBox -->
                            <TextBox Text="{Binding TagSearchText, Mode=TwoWay}" Watermark="Search tags..." Height="32" VerticalContentAlignment="Center"/>

                            <!-- Matching Logic Operator -->
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <RadioButton Content="ANY (OR)" IsChecked="{Binding IsMatchAny, Mode=TwoWay}" GroupName="MatchOperator" FontSize="10" Foreground="{DynamicResource Text.Primary}"/>
                                <RadioButton Content="ALL (AND)" IsChecked="{Binding IsMatchAll, Mode=TwoWay}" GroupName="MatchOperator" FontSize="10" Foreground="{DynamicResource Text.Primary}"/>
                                <RadioButton Content="NOT (EXCLUDE)" IsChecked="{Binding IsMatchNot, Mode=TwoWay}" GroupName="MatchOperator" FontSize="10" Foreground="{DynamicResource Text.Primary}"/>
                            </StackPanel>

                            <!-- Hierarchical Taxonomy Tree (Non-collapsible, cleanly indented) -->
                            <Border Background="{DynamicResource Surface.Card}" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}" Padding="6" MaxHeight="240">
                                <Panel>
                                    <!-- Empty State -->
                                    <TextBlock Text="No tags found" 
                                               Foreground="{DynamicResource Text.Muted}" 
                                               FontSize="11" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Margin="0,12" 
                                               IsVisible="{Binding !VisibleFlatNodes.Count}" />

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding VisibleFlatNodes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:TagFilterNodeViewModel">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                              IsThreeState="{Binding HasChildren}"
                                                              Margin="{Binding IndentMargin}" 
                                                              HorizontalAlignment="Stretch">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" 
                                                                       FontSize="12" 
                                                                       Foreground="{DynamicResource Text.Primary}" 
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Count, StringFormat='({0})'}" 
                                                                       FontSize="10" 
                                                                       Foreground="{DynamicResource Text.Secondary}" 
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Panel>
                            </Border>

                            <!-- Actions inside flyout -->
                            <Grid ColumnDefinitions="*,8,*">
                                <Button Grid.Column="0" Content="{Binding SelectAllButtonText}" Command="{Binding ToggleAllTagsCommand}" HorizontalAlignment="Stretch" Height="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="Secondary" FontSize="11"/>
                                <Button Grid.Column="2" Content="Clear Filter" Command="{Binding ClearTagFiltersCommand}" HorizontalAlignment="Stretch" Height="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="Secondary" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- More filters (orientation; room for camera, lens, date range later) -->
        <Button Classes="Basic" Padding="8,2" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip.Tip="More filters">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <icons:MaterialIcon Kind="TuneVariant" Width="14" Height="14" />
                <TextBlock Text="More" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel Spacing="8" Margin="4">
                        <TextBlock Text="Rating" FontSize="12" Foreground="{DynamicResource Text.Secondary}" />
                        <CheckBox IsChecked="{Binding IsStar0Active}" Content="Unrated only" FontSize="12" />
                        <TextBlock Text="Orientation" FontSize="12" Foreground="{DynamicResource Text.Secondary}" />
                    <StackPanel Orientation="Horizontal" Spacing="2">
                    <!-- Landscape -->
                    <ToggleButton Classes="FilterChip"
                    IsChecked="{Binding IsLandscapeActive}"
                    ToolTip.Tip="Filter Landscape">
                    <Path Data="M19,5H5C3.9,5,3,5.9,3,7V17C3,18.1,3.9,19,5,19H19C20.1,19,21,18.1,21,17V7C21,5.9,20.1,5,19,5M19,17H5V7H19V17Z"
                    Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource Text.Primary}"/>
                    </ToggleButton>

                    <!-- Portrait -->
                    <ToggleButton Classes="FilterChip"
                    IsChecked="{Binding IsPortraitActive}"
                    ToolTip.Tip="Filter Portrait">
                    <Path Data="M17,3H7C5.9,3,5,3.9,5,5V19C5,20.1,5.9,21,7,21H17C18.1,21,19,20.1,19,19V5C19,3.9,18.1,3,17,3M17,19H7V5H17V19Z"
                    Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource Text.Primary}"/>
                    </ToggleButton>
                    </StackPanel>

                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
