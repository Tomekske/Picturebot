<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Picturebot.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:Picturebot.Controls"
             x:DataType="vm:NewNodeDialogViewModel"
             x:Class="Picturebot.Views.NewNodeDialog">

    <UserControl.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
        </Style>

        <!-- Album | Folder segmented toggle -->
        <Style Selector="Button.segment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.segment:pointerover">
            <Setter Property="Background" Value="{DynamicResource State.Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        </Style>
        <Style Selector="Button.segment.active">
            <Setter Property="Background" Value="{DynamicResource Accent.Selected}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
        </Style>

        <!-- Hidden but still taking up space, so the dialog keeps one size in both modes -->
        <Style Selector=":is(Control).reserved">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
    </UserControl.Styles>

    <controls:DialogLayout Title="{Binding Title}" CloseCommand="{Binding CancelCommand}">
        <controls:DialogLayout.Footer>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="Secondary" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="Primary" Content="{Binding CreateButtonText}" Command="{Binding CreateCommand}" />
            </StackPanel>
        </controls:DialogLayout.Footer>

        <StackPanel Spacing="20">

            <!-- What to create -->
            <Border Background="{DynamicResource Surface.Card}" CornerRadius="6" Padding="2"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="segment"
                            Classes.active="{Binding IsAlbumMode}"
                            Command="{Binding SetModeCommand}"
                            CommandParameter="Album"
                            AutomationProperties.Name="Album">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="ImageAlbum" Width="14" Height="14" />
                            <TextBlock Text="Album" />
                        </StackPanel>
                    </Button>
                    <Button Classes="segment"
                            Classes.active="{Binding !IsAlbumMode}"
                            Command="{Binding SetModeCommand}"
                            CommandParameter="Folder"
                            AutomationProperties.Name="Folder">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="Folder" Width="14" Height="14" />
                            <TextBlock Text="Folder" />
                        </StackPanel>
                    </Button>
                    <Button Classes="segment"
                            Classes.active="{Binding IsImportMode}"
                            Command="{Binding SetModeCommand}"
                            CommandParameter="Import"
                            ToolTip.Tip="Import Albums (Recursive)"
                            AutomationProperties.Name="Import albums">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="FolderSync" Width="14" Height="14" />
                            <TextBlock Text="Import" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Source (albums only); its space stays reserved in folder mode -->
            <Grid>
            <TextBlock IsVisible="{Binding IsFolderMode}"
                       Text="A folder organises albums and other folders. No photos are imported."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       VerticalAlignment="Center" />
            <StackPanel Spacing="8" Classes.reserved="{Binding IsFolderMode}">
                <TextBlock Classes="fieldLabel" Text="{Binding SourceLabel}" />
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Text="{Binding SourcePath}"
                             Watermark="{Binding SourceWatermark}"
                             IsReadOnly="True"
                             Height="40"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="Secondary"
                            Margin="8,0,0,0"
                            Command="{Binding SelectSourcePathCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
                            <TextBlock Text="Browse" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
            </Grid>

            <!-- Name (an import names everything after the source folders); its space stays reserved -->
            <Grid>
                <TextBlock IsVisible="{Binding IsImportMode}"
                           Text="Names are taken from the folders in the source."
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}"
                           VerticalAlignment="Center" />
                <StackPanel Spacing="8" Classes.reserved="{Binding IsImportMode}">
                    <TextBlock Classes="fieldLabel" Text="NAME" />
                    <TextBox Text="{Binding Name}"
                             Watermark="{Binding NameWatermark}"
                             Height="40"
                             VerticalContentAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Location picker -->
            <StackPanel Spacing="8">
                <TextBlock Classes="fieldLabel" Text="LOCATION" />

                <controls:LocationPicker DataContext="{Binding Picker}" />
            </StackPanel>

            <!-- Time zone: empty inherits the zone of the nearest folder up the path that has one -->
            <StackPanel Spacing="8">
                <TextBlock Classes="fieldLabel" Text="TIME ZONE" />
                <controls:TimeZonePicker SelectedZoneId="{Binding TimeZoneId}"
                                         InheritedZoneId="{Binding InheritedTimeZoneId}"
                                         AllowNone="True" />
                <TextBlock Text="{Binding TimeZoneHint}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}" />
            </StackPanel>

            <!-- What will happen -->
            <Border Background="{DynamicResource Surface.Card}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="12,10">
                <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="WILL CREATE" />
                    <TextBlock Text="{Binding SummaryText}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource Text.Primary}" />
                    <TextBlock Text="{Binding SummaryDetail}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"
                                Classes.reserved="{Binding !HasValidationMessage}">
                        <icons:MaterialIcon Kind="AlertCircleOutline" Width="16" Height="16"
                                            Foreground="{DynamicResource Status.Warning}" />
                        <TextBlock Text="{Binding ValidationMessage}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource Status.Warning}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </controls:DialogLayout>
</UserControl>
