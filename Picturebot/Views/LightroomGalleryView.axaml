<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Picturebot.ViewModels"
             xmlns:conv="clr-namespace:Picturebot.Converters"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Picturebot.Views.LightroomGalleryView"
             x:DataType="vm:GalleryViewModel">

    <UserControl.Resources>
        <conv:AspectRatioConverter x:Key="AspectRatioConverter" />
        <conv:CurationStatusToBooleanConverter x:Key="CurationStatusToBooleanConverter" />
        <SolidColorBrush x:Key="AppBackground" Color="#0A0E14"/>
        <SolidColorBrush x:Key="CellBackground" Color="#1C232E"/>
        <SolidColorBrush x:Key="CellBorder" Color="#3A4454"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0078FF"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:PictureItemViewModel">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Name="AspectRatioWrapper" Margin="6">
                        <!-- Background/Matte Border -->
                        <Border Name="PART_AspectBorder"
                                Background="{StaticResource CellBackground}"
                                BorderBrush="{StaticResource CellBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Height="{Binding #AspectRatioWrapper.Bounds.Width, Converter={StaticResource AspectRatioConverter}, ConverterParameter=0.75}">
                            
                            <!-- Matted Image Container -->
                            <Panel>
                                <Panel Margin="8">
                                    <Image Source="{Binding Thumbnail}" 
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                        <Image.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.4" />
                                            </Transitions>
                                        </Image.Transitions>
                                    </Image>
                                </Panel>

                                <!-- Filename Overlay -->
                                <Border Name="FilenameOverlay"
                                        Background="#CC000000"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Stretch"
                                        Padding="4,6"
                                        IsVisible="False">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>

                                <!-- Flagged Indicator -->
                                <Border VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        Margin="4"
                                        Padding="4"
                                        CornerRadius="4"
                                        Background="#80000000"
                                        IsVisible="{Binding CurationStatus, Converter={StaticResource CurationStatusToBooleanConverter}, ConverterParameter=Flagged}">
                                    <icons:MaterialIcon Kind="Flag"
                                                        Width="16" Height="16"
                                                        Foreground="#4CAF50" />
                                </Border>
                            </Panel>
                        </Border>
                        
                        <!-- Selection Indicator (Electric Blue) -->
                        <Border Name="SelectionIndicator"
                                BorderBrush="{StaticResource AccentBlue}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Height="{Binding #PART_AspectBorder.Bounds.Height}"
                                IsHitTestVisible="False"
                                IsVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ Border#PART_AspectBorder">
            <Setter Property="Background" Value="#252E3B"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ Border#FilenameOverlay">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ Border#SelectionIndicator">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource AppBackground}">
        <ListBox ItemsSource="{Binding PicturesList}"
                 SelectedItem="{Binding SelectedPicture}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Strict 5 Columns -->
                    <UniformGrid Columns="5" VerticalAlignment="Top" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</UserControl>
