<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Picturebot.ViewModels"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             xmlns:controls="using:Picturebot.Controls"
             x:Class="Picturebot.Views.EditNodeDialog"
             x:DataType="vm:EditNodeDialogViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector="TextBlock.Action">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Accent.Foreground}" />
        </Style>
    </UserControl.Styles>
    
    <controls:DialogLayout Title="{Binding Title}" CloseCommand="{Binding CancelCommand}">
        <controls:DialogLayout.Footer>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="Secondary" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="Primary" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsCreatingNewFolder}" />
            </StackPanel>
        </controls:DialogLayout.Footer>

        <StackPanel Spacing="15">
            <StackPanel Spacing="5">
                <TextBlock Text="Name" FontWeight="SemiBold" />
                <TextBox Text="{Binding NodeName, Mode=TwoWay}" Watermark="Enter name..." />
            </StackPanel>
            
            <StackPanel Spacing="5">
                <TextBlock Text="Parent Location" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Parents}"
                          SelectedItem="{Binding SelectedParent}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.Styles>
                        <Style Selector="ComboBoxItem" x:DataType="vm:LocationItem">
                            <Setter Property="IsEnabled" Value="{Binding !IsSeparator}" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ComboBox.Styles>
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocationItem">
                            <Panel>
                                <Separator IsVisible="{Binding IsSeparator}" Margin="0" />
                                <TextBlock IsVisible="{Binding !IsSeparator}" 
                                           Text="{Binding Name}" 
                                           Padding="12,8"
                                           Classes.Action="{Binding IsAction}" />
                            </Panel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Inline Quick-Add Folder Input -->
            <Border IsVisible="{Binding IsCreatingNewFolder}"
                    Padding="15"
                    Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Dialog}">
                <StackPanel Spacing="10">
                    <TextBlock Text="New Parent Folder Name" FontWeight="SemiBold" FontSize="14" />
                    <TextBox Text="{Binding NewFolderName, Mode=TwoWay}" 
                             Watermark="Folder name..."
                             Classes="Simple" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="Secondary" Content="Cancel" Command="{Binding CancelNewFolderCommand}" />
                        <Button Classes="Primary" Content="Create" Command="{Binding ConfirmNewFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="5" IsVisible="{Binding HasTimeZone}">
                <TextBlock Text="Time Zone" FontWeight="SemiBold" />
                <controls:TimeZonePicker SelectedZoneId="{Binding TimeZoneId}"
                                         InheritedZoneId="{Binding InheritedTimeZoneId}"
                                         AllowNone="True" />
                <TextBlock Text="{Binding TimeZoneHint}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}" />
            </StackPanel>
        </StackPanel>
    </controls:DialogLayout>
</UserControl>
