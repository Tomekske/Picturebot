<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Picturebot.ViewModels"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:converters="using:Picturebot.Converters"
        xmlns:enums="using:Domain.Enums"
        xmlns:controls="using:Picturebot.Controls"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="Picturebot.Views.CarouselWindow"
        x:DataType="vm:CarouselDialogViewModel"
        Title="Carousel"
        Icon="/Assets/icon.ico"
        Background="Black"
        SystemDecorations="None"
        WindowState="FullScreen"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Focusable="True">

    <Window.Resources>
        <converters:CurationStatusToBrushConverter x:Key="CurationStatusToBrushConverter" />
        <converters:ColorLabelToBrushConverter x:Key="ColorLabelToBrushConverter" />
        <converters:RatingToBrushConverter x:Key="RatingToBrushConverter" />
        <converters:RatingToBooleanConverter x:Key="RatingToBooleanConverter" />
        <converters:ColorLabelToStrokeThicknessConverter x:Key="ColorLabelToStrokeThicknessConverter" />
    </Window.Resources>

    <Grid>
        <Canvas Background="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <controls:GpuAcceleratedCarousel
               Items="{Binding Previews}"
               SelectedIndex="{Binding CurrentIndex}"
               Margin="100,80,100,200"
               VerticalAlignment="Stretch"
               HorizontalAlignment="Stretch" />

        <Button HorizontalAlignment="Left" VerticalAlignment="Top"
                Classes="Basic" Margin="30"
                Command="{Binding CloseCommand}"
                Foreground="White"
                ZIndex="100">
            <icons:MaterialIcon Kind="Close" Width="40" Height="40" />
        </Button>

        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="30" Spacing="12" ZIndex="100">
            <!-- Main Metadata Badge -->
            <Border Background="#CC000000" CornerRadius="20" Padding="20,10" BorderBrush="#33FFFFFF"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <TextBlock Text="{Binding CounterText}"
                               FontSize="18"
                               Foreground="White" FontWeight="Bold" />
                    <Separator Width="1" Height="20" Background="#66FFFFFF" />
                    <TextBlock Text="{Binding Sharpness, StringFormat='Sharpness: {0}'}"
                               FontSize="18"
                               Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Burst Context Badge (Secondary) -->
            <Border Background="#CC000000" CornerRadius="15" Padding="15,8" BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding CurrentGroupName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <icons:MaterialIcon Kind="BurstMode" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentGroupName}"
                               FontSize="16"
                               Foreground="White" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                Classes="Basic" Margin="20,0,0,0"
                Command="{Binding PreviousCommand}"
                Foreground="#88FFFFFF"
                ZIndex="100">
            <icons:MaterialIcon Kind="ChevronLeft" Width="80" Height="80" />
        </Button>

        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                Classes="Basic" Margin="0,0,20,0"
                Command="{Binding NextCommand}"
                Foreground="#88FFFFFF"
                ZIndex="100">
            <icons:MaterialIcon Kind="ChevronRight" Width="80" Height="80" />
        </Button>

        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,50"
                Background="#EE151515"
                CornerRadius="30"
                Padding="15,10"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                ZIndex="100">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="Basic"
                        Command="{Binding SetCurationStatusCommand}"
                        CommandParameter="{x:Static enums:CurationStatus.Flagged}"
                        Padding="20,15">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <icons:MaterialIcon Kind="Flag" Width="36" Height="36"
                                            Foreground="{Binding CurrentPicture.CurationStatus, Converter={StaticResource CurationStatusToBrushConverter}, ConverterParameter=Flagged}" />
                        <TextBlock Text="Flagged" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="Basic"
                        Command="{Binding SetCurationStatusCommand}"
                        CommandParameter="{x:Static enums:CurationStatus.Unflagged}"
                        Padding="20,15">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <icons:MaterialIcon Kind="CircleOutline" Width="36" Height="36"
                                            Foreground="{Binding CurrentPicture.CurationStatus, Converter={StaticResource CurationStatusToBrushConverter}, ConverterParameter=Unflagged}" />
                        <TextBlock Text="Neutral" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="Basic"
                        Command="{Binding SetCurationStatusCommand}"
                        CommandParameter="{x:Static enums:CurationStatus.Rejected}"
                        Padding="20,15">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <icons:MaterialIcon Kind="Close" Width="36" Height="36"
                                            Foreground="{Binding CurrentPicture.CurationStatus, Converter={StaticResource CurationStatusToBrushConverter}, ConverterParameter=Rejected}" />
                        <TextBlock Text="Rejected" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Width="1" Height="40" Background="#44FFFFFF" Margin="10,0" />

                <!-- Star Rating -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="Basic" Command="{Binding SetRatingCommand}" CommandParameter="1" Padding="6">
                        <icons:MaterialIcon Kind="Star" Width="32" Height="32" 
                                            Foreground="{Binding CurrentPicture.Rating, Converter={StaticResource RatingToBrushConverter}, ConverterParameter=1}" />
                    </Button>
                    <Button Classes="Basic" Command="{Binding SetRatingCommand}" CommandParameter="2" Padding="6">
                        <icons:MaterialIcon Kind="Star" Width="32" Height="32" 
                                            Foreground="{Binding CurrentPicture.Rating, Converter={StaticResource RatingToBrushConverter}, ConverterParameter=2}" />
                    </Button>
                    <Button Classes="Basic" Command="{Binding SetRatingCommand}" CommandParameter="3" Padding="6">
                        <icons:MaterialIcon Kind="Star" Width="32" Height="32" 
                                            Foreground="{Binding CurrentPicture.Rating, Converter={StaticResource RatingToBrushConverter}, ConverterParameter=3}" />
                    </Button>
                    <Button Classes="Basic" Command="{Binding SetRatingCommand}" CommandParameter="4" Padding="6">
                        <icons:MaterialIcon Kind="Star" Width="32" Height="32" 
                                            Foreground="{Binding CurrentPicture.Rating, Converter={StaticResource RatingToBrushConverter}, ConverterParameter=4}" />
                    </Button>
                    <Button Classes="Basic" Command="{Binding SetRatingCommand}" CommandParameter="5" Padding="6">
                        <icons:MaterialIcon Kind="Star" Width="32" Height="32" 
                                            Foreground="{Binding CurrentPicture.Rating, Converter={StaticResource RatingToBrushConverter}, ConverterParameter=5}" />
                    </Button>
                </StackPanel>

                <Separator Width="1" Height="40" Background="#44FFFFFF" Margin="10,0" />

                <!-- Color Labels -->
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="5,0">
                    <Button Classes="Basic" Command="{Binding SetColorLabelCommand}" CommandParameter="{x:Static enums:ColorLabel.Red}" Padding="0">
                        <Ellipse Width="24" Height="24" Fill="#CC3333" 
                                 Stroke="White" StrokeThickness="{Binding CurrentPicture.ColorLabel, Converter={StaticResource ColorLabelToStrokeThicknessConverter}, ConverterParameter=Red}" />
                    </Button>
                    <Button Classes="Basic" Command="{Binding SetColorLabelCommand}" CommandParameter="{x:Static enums:ColorLabel.Yellow}" Padding="0">
                        <Ellipse Width="24" Height="24" Fill="#CCCC33" 
                                 Stroke="White" StrokeThickness="{Binding CurrentPicture.ColorLabel, Converter={StaticResource ColorLabelToStrokeThicknessConverter}, ConverterParameter=Yellow}" />
                    </Button>
                    <Button Classes="Basic" Command="{Binding SetColorLabelCommand}" CommandParameter="{x:Static enums:ColorLabel.Green}" Padding="0">
                        <Ellipse Width="24" Height="24" Fill="#33CC33" 
                                 Stroke="White" StrokeThickness="{Binding CurrentPicture.ColorLabel, Converter={StaticResource ColorLabelToStrokeThicknessConverter}, ConverterParameter=Green}" />
                    </Button>
                    <Button Classes="Basic" Command="{Binding SetColorLabelCommand}" CommandParameter="{x:Static enums:ColorLabel.Blue}" Padding="0">
                        <Ellipse Width="24" Height="24" Fill="#3333CC" 
                                 Stroke="White" StrokeThickness="{Binding CurrentPicture.ColorLabel, Converter={StaticResource ColorLabelToStrokeThicknessConverter}, ConverterParameter=Blue}" />
                    </Button>
                    <Button Classes="Basic" Command="{Binding SetColorLabelCommand}" CommandParameter="{x:Static enums:ColorLabel.Purple}" Padding="0">
                        <Ellipse Width="24" Height="24" Fill="#CC33CC" 
                                 Stroke="White" StrokeThickness="{Binding CurrentPicture.ColorLabel, Converter={StaticResource ColorLabelToStrokeThicknessConverter}, ConverterParameter=Purple}" />
                    </Button>
                    <Button Classes="Basic" Command="{Binding SetColorLabelCommand}" CommandParameter="{x:Static enums:ColorLabel.None}" Padding="6">
                        <icons:MaterialIcon Kind="LabelOffOutline" Width="24" Height="24" Foreground="White" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
