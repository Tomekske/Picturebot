<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Picturebot.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Picturebot.Views.NavigationPaneView"
             x:DataType="vm:NavigationPaneViewModel">
    <Grid RowDefinitions="Auto, *" Margin="0,40,0,0">
        <Grid ColumnDefinitions="*, Auto" Margin="15,10">
            <TextBlock Text="Library"
                       Classes="h3"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding OpenCreateFolderDialogCommand}"
                        Classes="Basic"
                        ToolTip.Tip="Create New Folder"
                        Cursor="Hand"
                        Padding="6"
                        CornerRadius="8">
                    <icons:MaterialIcon Kind="FolderPlus" Width="22" Height="22" Foreground="#FFD700" />
                </Button>

                <Button Command="{Binding OpenAddAlbumDialogCommand}"
                        Classes="Basic"
                        ToolTip.Tip="Add New Album"
                        Cursor="Hand"
                        Padding="6"
                        CornerRadius="8">
                    <icons:MaterialIcon Kind="ImageAlbum" Width="22" Height="22" Foreground="#87CEEB" />
                </Button>

                <Button Command="{Binding OpenImportAlbumsDialogCommand}"
                        Classes="Basic"
                        ToolTip.Tip="Import Albums (Recursive)"
                        Cursor="Hand"
                        Padding="6"
                        CornerRadius="8">
                    <icons:MaterialIcon Kind="FolderSync" Width="22" Height="22" Foreground="#98FB98" />
                </Button>
            </StackPanel>
        </Grid>

        <TreeView Grid.Row="1"
                  ItemsSource="{Binding Folders}"
                  Background="Transparent"
                  BorderThickness="0">
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:NavigationNodeViewModel">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="MinHeight" Value="32" />
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:NavigationNodeViewModel">
                    <Grid Name="NodeContainer"
                          ColumnDefinitions="Auto, *, Auto"
                          HorizontalAlignment="Stretch"
                          Height="32"
                          VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Panel Width="18" Height="18" VerticalAlignment="Center">
                                <icons:MaterialIcon Kind="Folder"
                                                    IsVisible="{Binding IsFolder}"
                                                    Foreground="#FFD700" />
                                <icons:MaterialIcon Kind="ImageAlbum"
                                                    IsVisible="{Binding IsAlbum}"
                                                    Foreground="#87CEEB" />
                            </Panel>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="10,0,0,0"
                                    IsVisible="{Binding IsSelected}">
                            <Button Classes="Basic"
                                    Padding="4"
                                    ToolTip.Tip="Edit">
                                <icons:MaterialIcon Kind="Pencil" Width="14" Height="14"
                                                    Foreground="{DynamicResource SukiText}" />
                            </Button>
                            <Button Classes="Basic"
                                    Padding="4"
                                    ToolTip.Tip="Delete">
                                <icons:MaterialIcon Kind="Delete" Width="14" Height="14"
                                                    Foreground="{DynamicResource SukiText}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
