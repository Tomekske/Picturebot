<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Picturebot.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:DataType="vm:AiCurationResultDialogViewModel"
             xmlns:controls="using:Picturebot.Controls"
             x:Class="Picturebot.Views.AiCurationResultDialog">

    <controls:DialogLayout Title="AI Curation Suggestions" Size="Large" CloseCommand="{Binding CancelCommand}">
        <controls:DialogLayout.HeaderIcon>
            <icons:MaterialIcon Kind="AutoFix" Width="20" Height="20" Foreground="{DynamicResource Accent.Foreground}" />
        </controls:DialogLayout.HeaderIcon>
        <controls:DialogLayout.Footer>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="Secondary" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="Primary" Content="Confirm Suggestions" Command="{Binding ApplyCommand}" />
            </StackPanel>
        </controls:DialogLayout.Footer>

        <StackPanel Spacing="16">
            <!-- Subtitle / Instruction Box -->
            <Border Background="{DynamicResource Surface.Panel}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
                <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" LineHeight="18">
                    Review Gemini evaluations. Best Pick is marked <Span Foreground="{DynamicResource Status.Picked}" FontWeight="Bold">Green (5 Stars)</Span> and Alternatives <Span Foreground="{DynamicResource Label.Orange}" FontWeight="Bold">Orange (0 Stars)</Span>.
                    To change the Best Pick, simply click another photo before confirming.
                </TextBlock>
            </Border>

            <!-- Results List -->
            <Border BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MinHeight="200"
                    MaxHeight="540"
                    Background="{DynamicResource Surface.App}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiCurationGroupResultViewModel">
                                <StackPanel Spacing="10" Margin="0,0,0,16">
                                    <!-- Burst Header if present -->
                                    <Border Background="{DynamicResource Surface.Panel}"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            IsVisible="{Binding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding Header}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text.Primary}" />
                                    </Border>

                                    <!-- Pictures in this Burst -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AiCurationItemResultViewModel">
                                                <Grid ColumnDefinitions="28, *" Margin="0,0,0,10">
                                                    <!-- Index Number Outside Card -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Index}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Text.Muted}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />

                                                    <!-- Picture Card -->
                                                    <Border Grid.Column="1"
                                                            Background="{Binding CardBackground}"
                                                            BorderBrush="{Binding CardBorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="10"
                                                            Padding="12">
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <!-- Thumbnail -->
                                                            <Border Grid.Column="0"
                                                                    Width="68"
                                                                    Height="68"
                                                                    CornerRadius="8"
                                                                    ClipToBounds="True"
                                                                    Background="{DynamicResource Surface.App}"
                                                                    Margin="0,0,14,0"
                                                                    VerticalAlignment="Center">
                                                                <Panel>
                                                                    <icons:MaterialIcon Kind="ImageOutline"
                                                                                        Width="28"
                                                                                        Height="28"
                                                                                        Foreground="{DynamicResource Surface.Raised}"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                                                                    <Image Source="{Binding Thumbnail}"
                                                                           Stretch="UniformToFill"
                                                                           IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                                </Panel>
                                                            </Border>

                                                            <!-- Name & Feedback -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="Bold"
                                                                           FontSize="13.5"
                                                                           Foreground="{DynamicResource Text.Primary}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Feedback}"
                                                                           FontSize="11.5"
                                                                           Foreground="{DynamicResource Text.Secondary}"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="16" />
                                                            </StackPanel>

                                                            <!-- Badges & Action -->
                                                            <Grid Grid.Column="2" RowDefinitions="Auto, *" VerticalAlignment="Stretch">
                                                                <!-- Pill Badge -->
                                                                <Border Grid.Row="0"
                                                                        Background="{Binding BadgeBackground}"
                                                                        CornerRadius="5"
                                                                        Padding="10,4"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding BadgeText}"
                                                                               FontSize="10.5"
                                                                               FontWeight="Black"
                                                                               Foreground="{Binding BadgeForeground}" />
                                                                </Border>

                                                                <!-- Action Button / Confirmed Tag -->
                                                                <StackPanel Grid.Row="1"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Bottom"
                                                                            Margin="0,8,0,0">
                                                                    <!-- Best Pick Confirmed State -->
                                                                    <Border IsVisible="{Binding IsBest}"
                                                                            Background="{DynamicResource Status.Picked.Subtle}"
                                                                            BorderBrush="{DynamicResource Status.Picked.Border}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="10,6">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <icons:MaterialIcon Kind="Check" Width="14" Height="14" Foreground="{DynamicResource Status.Picked}" />
                                                                            <TextBlock Text="Confirm Pick" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Status.Picked}" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- Alternative Select Button -->
                                                                    <Button IsVisible="{Binding CanSetAsBest}"
                                                                            Command="{Binding SelectAsBestCommand}"
                                                                            Background="{DynamicResource Status.Picked}"
                                                                            Foreground="{DynamicResource Text.Primary}"
                                                                            CornerRadius="6"
                                                                            Padding="10,6"
                                                                            Cursor="Hand">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <icons:MaterialIcon Kind="SquareEditOutline" Width="14" Height="14" Foreground="{DynamicResource Text.Primary}" />
                                                                            <TextBlock Text="Set as Best Pick" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

        </StackPanel>
    </controls:DialogLayout>
</UserControl>
