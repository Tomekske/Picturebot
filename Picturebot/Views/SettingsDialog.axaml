<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Picturebot.ViewModels"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:icons="using:Material.Icons"
        x:DataType="vm:SettingsDialogViewModel"
        x:Class="Picturebot.Views.SettingsDialog"
        Title="Settings"
        SystemDecorations="None"
        Background="Transparent"
        Width="840"
        Height="580"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Window Outer Styles -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Roboto, Outfit, Segoe UI, sans-serif" />
        </Style>

        <!-- Sidebar ListBox Styles -->
        <Style Selector="ListBox.sidebar-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,16" />
        </Style>
        <Style Selector="ListBox.sidebar-list ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.sidebar-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="#29292F" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ListBox.sidebar-list ListBoxItem:selected">
            <Setter Property="Background" Value="#38383E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ListBox.sidebar-list ListBoxItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#38383E" />
        </Style>
        <Style Selector="ListBox.sidebar-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Form Input Styling -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#252529" />
            <Setter Property="BorderBrush" Value="#333337" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#4F46E5" />
            <Setter Property="Background" Value="#252529" />
        </Style>

        <!-- NumericUpDown Styling -->
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="#252529" />
            <Setter Property="BorderBrush" Value="#333337" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Theme Button Styling -->
        <Style Selector="Button.theme-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#333337" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.theme-btn:pointerover">
            <Setter Property="Background" Value="#252529" />
        </Style>
        <Style Selector="Button.theme-btn.active">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="BorderBrush" Value="#4F46E5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.theme-btn.system-active">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="BorderBrush" Value="#D4AF37" />
            <Setter Property="Foreground" Value="#D4AF37" />
        </Style>

        <!-- Standard Button Styles -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#38383E" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#4338CA" />
        </Style>

        <!-- Section Label Text -->
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </Window.Styles>

    <Border CornerRadius="10" Background="#1E1E22" BorderBrush="#333337" BorderThickness="1" ClipToBounds="True">
        <DockPanel LastChildFill="True">
            <!-- Header Bar -->
            <Grid DockPanel.Dock="Top" Height="48" Background="#1E1E22" PointerPressed="Header_PointerPressed">
                <TextBlock Text="Settings" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="#FFFFFF" 
                           VerticalAlignment="Center" 
                           Margin="16,0,0,0" />
                
                <Button Command="{Binding CloseDialogCommand}" 
                        CommandParameter="{Binding $parent[Window]}"
                        Background="Transparent" 
                        BorderThickness="0" 
                        Foreground="#AAAAAA" 
                        FontSize="16" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Margin="0,0,16,0"
                        Padding="4">
                    <TextBlock Text="✕" />
                </Button>
                
                <!-- Header Bottom Divider -->
                <Rectangle Height="1" Fill="#2A2A2E" VerticalAlignment="Bottom" />
            </Grid>

            <!-- Footer Action Bar -->
            <Grid DockPanel.Dock="Bottom" Height="56" Background="#1E1E22">
                <!-- Footer Top Divider -->
                <Rectangle Height="1" Fill="#2A2A2E" VerticalAlignment="Top" />
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12" Margin="0,0,16,0">
                    <Button Classes="secondary" 
                            Content="Revert to Default" 
                            Command="{Binding RevertToDefaultCommand}" />
                    <Button Classes="primary" 
                            Content="Save Changes" 
                            Command="{Binding SaveSettingsCommand}" 
                            CommandParameter="{Binding $parent[Window]}" />
                </StackPanel>
            </Grid>

            <!-- Sidebar Navigation Column -->
            <Grid ColumnDefinitions="200,1,*">
                <ListBox Grid.Column="0" 
                         Classes="sidebar-list" 
                         SelectedIndex="{Binding SelectedTabIndex}">
                    <ListBoxItem Content="General" />
                    <ListBoxItem Content="Storage &amp; Paths" />
                    <ListBoxItem Content="Culling" />
                    <ListBoxItem Content="Color Labels" />
                    <ListBoxItem Content="Keyboard Shortcuts" />
                </ListBox>

                <!-- Vertical Divider -->
                <Rectangle Grid.Column="1" Width="1" Fill="#2A2A2E" />

                <!-- Content Area -->
                <ScrollViewer Grid.Column="2" Padding="24,16" VerticalScrollBarVisibility="Auto">
                    <Carousel SelectedIndex="{Binding SelectedTabIndex}">
                        <!-- View 0: General -->
                        <StackPanel Spacing="20">
                            <TextBlock Text="General Settings" Classes="section-header" />
                            
                            <StackPanel Spacing="8">
                                <TextBlock Text="THEME" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" LetterSpacing="1" />
                                <UniformGrid Columns="3" Height="40">
                                    <Button Classes="theme-btn" 
                                            Classes.active="{Binding IsLightActive}"
                                            Command="{Binding SetLightThemeCommand}"
                                            Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <material:MaterialIcon Kind="WhiteBalanceSunny" Width="16" Height="16" />
                                            <TextBlock Text="Light" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="theme-btn" 
                                            Classes.active="{Binding IsDarkActive}"
                                            Command="{Binding SetDarkThemeCommand}"
                                            Margin="4,0,4,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <material:MaterialIcon Kind="WeatherNight" Width="16" Height="16" />
                                            <TextBlock Text="Dark" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="theme-btn" 
                                            Classes.system-active="{Binding IsSystemActive}"
                                            Command="{Binding SetSystemThemeCommand}"
                                            Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <material:MaterialIcon Kind="Settings" Width="16" Height="16" />
                                            <TextBlock Text="System" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel Spacing="8" Margin="0,10,0,0">
                                <TextBlock Text="WINDOW OPTIONS" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" LetterSpacing="1" />
                                <CheckBox IsChecked="{Binding LaunchFullScreen}" 
                                          Content="Launch Full Screen" 
                                          Foreground="#FFFFFF" 
                                          FontSize="13" />
                            </StackPanel>
                        </StackPanel>

                        <!-- View 1: Storage & Paths -->
                        <StackPanel Spacing="20">
                            <TextBlock Text="Storage &amp; Paths" Classes="section-header" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Library Location" FontSize="12" Foreground="#AAAAAA" />
                                <TextBox Text="{Binding LibraryLocation}" Watermark="Select Library Path" IsReadOnly="True" Height="36" VerticalContentAlignment="Center">
                                    <TextBox.InnerRightContent>
                                        <Button Command="{Binding BrowseLibraryLocationCommand}" Background="Transparent" BorderThickness="0" Padding="8,4">
                                            <material:MaterialIcon Kind="FolderOpenOutline" Foreground="#AAAAAA" Width="18" Height="18" />
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Edit Destination Folder" FontSize="12" Foreground="#AAAAAA" />
                                <TextBox Text="{Binding EditFolderPath}" Watermark="Select Edit Destination Path (Ctrl+E)" IsReadOnly="True" Height="36" VerticalContentAlignment="Center">
                                    <TextBox.InnerRightContent>
                                        <Button Command="{Binding BrowseEditFolderCommand}" Background="Transparent" BorderThickness="0" Padding="8,4">
                                            <material:MaterialIcon Kind="FolderOpenOutline" Foreground="#AAAAAA" Width="18" Height="18" />
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Print Destination Folder" FontSize="12" Foreground="#AAAAAA" />
                                <TextBox Text="{Binding PrintFolderPath}" Watermark="Select Print Destination Path (Shift+E)" IsReadOnly="True" Height="36" VerticalContentAlignment="Center">
                                    <TextBox.InnerRightContent>
                                        <Button Command="{Binding BrowsePrintFolderCommand}" Background="Transparent" BorderThickness="0" Padding="8,4">
                                            <material:MaterialIcon Kind="FolderOpenOutline" Foreground="#AAAAAA" Width="18" Height="18" />
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- View 2: Culling -->
                        <StackPanel Spacing="20">
                            <TextBlock Text="Culling Settings" Classes="section-header" />

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" Margin="0,0,8,16">
                                    <TextBlock Text="Grouping Threshold" FontSize="12" Foreground="#AAAAAA" />
                                    <NumericUpDown Value="{Binding GroupingThreshold}" Minimum="1" Maximum="100" FormatString="0" Height="36" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6" Margin="8,0,0,16">
                                    <TextBlock Text="Burst Time Threshold (Seconds)" FontSize="12" Foreground="#AAAAAA" />
                                    <NumericUpDown Value="{Binding BurstTimeThreshold}" Minimum="1" Maximum="60" FormatString="0" Height="36" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                    <TextBlock Text="Burst Fallback Time (Seconds)" FontSize="12" Foreground="#AAAAAA" />
                                    <NumericUpDown Value="{Binding BurstFallbackThreshold}" Minimum="1" Maximum="120" FormatString="0" Height="36" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- View 3: Color Labels -->
                        <StackPanel Spacing="20">
                            <TextBlock Text="Color Label Names" Classes="section-header" />

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4">
                                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding RedLabelName}" Watermark="Red Label" Margin="0,0,6,12" Height="36" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#B71C1C" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OrangeLabelName}" Watermark="Orange Label" Margin="6,0,0,12" Height="36" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#E67E22" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding YellowLabelName}" Watermark="Yellow Label" Margin="0,0,6,12" Height="36" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#FDD835" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GreenLabelName}" Watermark="Green Label" Margin="6,0,0,12" Height="36" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#33CC33" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding BlueLabelName}" Watermark="Blue Label" Margin="0,0,6,12" Height="36" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#3333CC" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PinkLabelName}" Watermark="Pink Label" Margin="6,0,0,12" Height="36" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#F06292" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding PurpleLabelName}" Watermark="Purple Label" Margin="0,0,6,0" Height="36" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#CC33CC" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>
                        </StackPanel>

                        <!-- View 4: Keyboard Shortcuts -->
                        <StackPanel Spacing="20">
                            <TextBlock Text="Keyboard Shortcuts" Classes="section-header" />
                            <TextBlock Text="Click a field and press a key combination to record. Backspace/Delete clears." 
                                       FontSize="11" Foreground="#AAAAAA" Margin="0,-12,0,10" />

                            <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <!-- General shortcuts -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="GENERAL" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" LetterSpacing="1" />
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" Margin="0,2">
                                            <TextBox Grid.Row="0" Grid.Column="0" Tag="Fullscreen" Text="{Binding FullscreenShortcut, Mode=TwoWay}" Watermark="Fullscreen" Margin="0,0,6,0" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <TextBlock Text="Fullscreen:" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#AAAAAA" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="0" Grid.Column="1" Tag="OpenInExplorer" Text="{Binding OpenInExplorerShortcut, Mode=TwoWay}" Watermark="Open in Explorer" Margin="6,0,0,0" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <TextBlock Text="Explorer:" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#AAAAAA" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Color assignment shortcuts -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="COLOR LABELS" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" LetterSpacing="1" />
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2">
                                            <TextBox Grid.Row="0" Grid.Column="0" Tag="Red" Text="{Binding RedLabelShortcut, Mode=TwoWay}" Watermark="None" Margin="0,0,6,8" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <material:MaterialIcon Kind="Circle" Foreground="#B71C1C" Width="12" Height="12" Margin="10,0,0,0" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="0" Grid.Column="1" Tag="Orange" Text="{Binding OrangeLabelShortcut, Mode=TwoWay}" Watermark="None" Margin="6,0,0,8" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <material:MaterialIcon Kind="Circle" Foreground="#E67E22" Width="12" Height="12" Margin="10,0,0,0" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="1" Grid.Column="0" Tag="Yellow" Text="{Binding YellowLabelShortcut, Mode=TwoWay}" Watermark="None" Margin="0,0,6,8" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <material:MaterialIcon Kind="Circle" Foreground="#FDD835" Width="12" Height="12" Margin="10,0,0,0" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="1" Grid.Column="1" Tag="Green" Text="{Binding GreenLabelShortcut, Mode=TwoWay}" Watermark="None" Margin="6,0,0,8" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <material:MaterialIcon Kind="Circle" Foreground="#33CC33" Width="12" Height="12" Margin="10,0,0,0" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="2" Grid.Column="0" Tag="Blue" Text="{Binding BlueLabelShortcut, Mode=TwoWay}" Watermark="None" Margin="0,0,6,8" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <material:MaterialIcon Kind="Circle" Foreground="#3333CC" Width="12" Height="12" Margin="10,0,0,0" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="2" Grid.Column="1" Tag="Pink" Text="{Binding PinkLabelShortcut, Mode=TwoWay}" Watermark="None" Margin="6,0,0,8" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <material:MaterialIcon Kind="Circle" Foreground="#F06292" Width="12" Height="12" Margin="10,0,0,0" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="3" Grid.Column="0" Tag="Purple" Text="{Binding PurpleLabelShortcut, Mode=TwoWay}" Watermark="None" Margin="0,0,6,0" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <material:MaterialIcon Kind="Circle" Foreground="#CC33CC" Width="12" Height="12" Margin="10,0,0,0" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="3" Grid.Column="1" Tag="None" Text="{Binding NoneLabelShortcut, Mode=TwoWay}" Watermark="None" Margin="6,0,0,0" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <material:MaterialIcon Kind="LabelOffOutline" Foreground="Gray" Width="12" Height="12" Margin="10,0,0,0" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Ratings shortcuts -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="STAR RATINGS" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" LetterSpacing="1" />
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2">
                                            <TextBox Grid.Row="0" Grid.Column="0" Tag="Rating1" Text="{Binding Rating1Shortcut, Mode=TwoWay}" Watermark="1 Star" Margin="0,0,6,8" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <TextBlock Text="1 Star:" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#AAAAAA" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="0" Grid.Column="1" Tag="Rating2" Text="{Binding Rating2Shortcut, Mode=TwoWay}" Watermark="2 Stars" Margin="6,0,0,8" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <TextBlock Text="2 Stars:" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#AAAAAA" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="1" Grid.Column="0" Tag="Rating3" Text="{Binding Rating3Shortcut, Mode=TwoWay}" Watermark="3 Stars" Margin="0,0,6,8" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <TextBlock Text="3 Stars:" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#AAAAAA" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="1" Grid.Column="1" Tag="Rating4" Text="{Binding Rating4Shortcut, Mode=TwoWay}" Watermark="4 Stars" Margin="6,0,0,8" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <TextBlock Text="4 Stars:" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#AAAAAA" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="2" Grid.Column="0" Tag="Rating5" Text="{Binding Rating5Shortcut, Mode=TwoWay}" Watermark="5 Stars" Margin="0,0,6,0" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <TextBlock Text="5 Stars:" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#AAAAAA" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="2" Grid.Column="1" Tag="Rating0" Text="{Binding Rating0Shortcut, Mode=TwoWay}" Watermark="0 Stars / None" Margin="6,0,0,0" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <TextBlock Text="0 Stars:" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#AAAAAA" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Curation shortcuts -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="CURATION STATUS" FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" LetterSpacing="1" />
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,2">
                                            <TextBox Grid.Row="0" Grid.Column="0" Tag="CurationPicked" Text="{Binding CurationPickedShortcut, Mode=TwoWay}" Watermark="Picked" Margin="0,0,6,8" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <TextBlock Text="Picked:" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#AAAAAA" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="0" Grid.Column="1" Tag="CurationRejected" Text="{Binding CurationRejectedShortcut, Mode=TwoWay}" Watermark="Rejected" Margin="6,0,0,8" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <TextBlock Text="Rejected:" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#AAAAAA" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <TextBox Grid.Row="1" Grid.Column="0" Tag="CurationNeutral" Text="{Binding CurationNeutralShortcut, Mode=TwoWay}" Watermark="Neutral" Margin="0,0,6,0" Height="36" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center">
                                                <TextBox.InnerLeftContent>
                                                    <TextBlock Text="Neutral:" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#AAAAAA" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Carousel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
