<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Picturebot.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:icons="using:Material.Icons"
             x:DataType="vm:SettingsDialogViewModel"
             x:Class="Picturebot.Views.SettingsDialog"
             Width="520">

    <StackPanel Spacing="24">

        <TextBlock Text="Settings"
                   FontSize="22"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

        <StackPanel Spacing="10">
            <TextBlock Text="THEME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SukiLowText}"
                       LetterSpacing="1" />
            <UniformGrid Columns="3" Height="45">
                <Button Command="{Binding SetLightThemeCommand}"
                        Classes.Accent="{Binding IsLightActive}"
                        Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="{x:Static icons:MaterialIconKind.WhiteBalanceSunny}"
                                               Width="18" Height="18" />
                        <TextBlock Text="Light" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetDarkThemeCommand}"
                        Classes.Accent="{Binding IsDarkActive}"
                        Margin="4,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="{x:Static icons:MaterialIconKind.WeatherNight}" Width="18"
                                               Height="18" />
                        <TextBlock Text="Dark" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetSystemThemeCommand}"
                        Classes.Accent="{Binding IsSystemActive}"
                        Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="{x:Static icons:MaterialIconKind.Settings}" Width="18"
                                               Height="18" />
                        <TextBlock Text="System" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="LIBRARY LOCATION" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource SukiLowText}" LetterSpacing="1" />
            <DockPanel LastChildFill="True">
                <Button Command="{Binding BrowseLibraryLocationCommand}"
                        Content="Browse"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Padding="16,0" />
                <TextBox Text="{Binding LibraryLocation}"
                         Watermark="This folder will be used to store your albums"
                         Height="40"
                         VerticalContentAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="GROUPING THRESHOLD" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource SukiLowText}" LetterSpacing="1" />
            <NumericUpDown Value="{Binding GroupingThreshold}"
                           Minimum="1"
                           Maximum="100"
                           FormatString="0"
                           HorizontalAlignment="Left"
                           Width="120"
                           Height="40" />
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="BURST TIME THRESHOLD (SECONDS)" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource SukiLowText}" LetterSpacing="1" />
            <NumericUpDown Value="{Binding BurstTimeThreshold}"
                           Minimum="1"
                           Maximum="60"
                           FormatString="0"
                           HorizontalAlignment="Left"
                           Width="120"
                           Height="40" />
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="BURST FALLBACK TIME (SECONDS)" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource SukiLowText}" LetterSpacing="1" />
            <NumericUpDown Value="{Binding BurstFallbackThreshold}"
                           Minimum="1"
                           Maximum="120"
                           FormatString="0"
                           HorizontalAlignment="Left"
                           Width="120"
                           Height="40" />
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="WINDOW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SukiLowText}"
                       LetterSpacing="1" />
            <CheckBox IsChecked="{Binding LaunchFullScreen}"
                      Content="Launch Full Screen"
                      FontSize="14" />
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="COLOR LABEL NAMES" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource SukiLowText}" LetterSpacing="1" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4">
                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding RedLabelName}" Watermark="Red Label" Margin="0,0,4,8">
                    <TextBox.InnerLeftContent>
                        <material:MaterialIcon Kind="Circle" Foreground="#B71C1C" Width="14" Height="14" Margin="10,0,0,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OrangeLabelName}" Watermark="Orange Label" Margin="4,0,0,8">
                    <TextBox.InnerLeftContent>
                        <material:MaterialIcon Kind="Circle" Foreground="#E67E22" Width="14" Height="14" Margin="10,0,0,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding YellowLabelName}" Watermark="Yellow Label" Margin="0,0,4,8">
                    <TextBox.InnerLeftContent>
                        <material:MaterialIcon Kind="Circle" Foreground="#FDD835" Width="14" Height="14" Margin="10,0,0,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GreenLabelName}" Watermark="Green Label" Margin="4,0,0,8">
                    <TextBox.InnerLeftContent>
                        <material:MaterialIcon Kind="Circle" Foreground="#33CC33" Width="14" Height="14" Margin="10,0,0,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding BlueLabelName}" Watermark="Blue Label" Margin="0,0,4,8">
                    <TextBox.InnerLeftContent>
                        <material:MaterialIcon Kind="Circle" Foreground="#3333CC" Width="14" Height="14" Margin="10,0,0,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PinkLabelName}" Watermark="Pink Label" Margin="4,0,0,8">
                    <TextBox.InnerLeftContent>
                        <material:MaterialIcon Kind="Circle" Foreground="#F06292" Width="14" Height="14" Margin="10,0,0,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding PurpleLabelName}" Watermark="Purple Label" Margin="0,0,4,0">
                    <TextBox.InnerLeftContent>
                        <material:MaterialIcon Kind="Circle" Foreground="#CC33CC" Width="14" Height="14" Margin="10,0,0,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Grid>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
            <Button Command="{Binding CloseDialogCommand}"
                    Content="Cancel"
                    Classes.Accent="False"
                    Width="100"
                    Height="40" />
            <Button Command="{Binding SaveSettingsCommand}"
                    Content="Save"
                    Classes.Accent="True"
                    Width="100"
                    Height="40" />
        </StackPanel>

    </StackPanel>
</UserControl>
