<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Picturebot.ViewModels"
        xmlns:models="using:Domain.Models"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:icons="using:Material.Icons"
        x:DataType="vm:SettingsDialogViewModel"
        x:Class="Picturebot.Views.SettingsDialog"
        Title="Settings"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Width="860"
        Height="600"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Window Outer Styles -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Roboto, Outfit, Segoe UI, sans-serif" />
        </Style>

        <!-- Sidebar ListBox Styles -->
        <Style Selector="ListBox.sidebar-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,16" />
        </Style>
        <Style Selector="ListBox.sidebar-list ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.sidebar-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="#29292F" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ListBox.sidebar-list ListBoxItem:selected">
            <Setter Property="Background" Value="#38383E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ListBox.sidebar-list ListBoxItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#38383E" />
        </Style>
        <Style Selector="ListBox.sidebar-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Sub-Tab Button Styling -->
        <Style Selector="Button.subtab-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.subtab-btn:pointerover">
            <Setter Property="Background" Value="#252529" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.subtab-btn.active">
            <Setter Property="Background" Value="#38383E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Form Input Styling -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#252529" />
            <Setter Property="BorderBrush" Value="#333337" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#4F46E5" />
            <Setter Property="Background" Value="#252529" />
        </Style>

        <Style Selector="AutoCompleteBox">
            <Setter Property="Background" Value="#14171F" />
            <Setter Property="BorderBrush" Value="#323846" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <!-- General AutoCompleteBox Dropdown Popup Dark Theme Styling (Matching ComboBox Style) -->
        <Style Selector="AutoCompleteBox /template/ Popup#PART_Popup">
            <Setter Property="Placement" Value="BottomEdgeAlignedLeft" />
            <Setter Property="VerticalOffset" Value="4" />
            <Setter Property="HorizontalOffset" Value="0" />
        </Style>
        <Style Selector="AutoCompleteBox /template/ Border#PART_SuggestionsContainer">
            <Setter Property="Background" Value="#20232B" />
            <Setter Property="BorderBrush" Value="#383C4D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BoxShadow" Value="0 8 24 #60000000" />
            <Setter Property="Padding" Value="4,4" />
        </Style>
        <Style Selector="AutoCompleteBox /template/ ListBox#PART_SelectingItemsControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MaxHeight" Value="200" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="AutoCompleteBox ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="AutoCompleteBox ListBoxItem:pointerover">
            <Setter Property="Background" Value="#2F3648" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="AutoCompleteBox ListBoxItem:pointerover /template/ Border#PART_ItemBorder">
            <Setter Property="Background" Value="#2F3648" />
        </Style>
        <Style Selector="AutoCompleteBox ListBoxItem:selected">
            <Setter Property="Background" Value="#4C5FD5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="AutoCompleteBox ListBoxItem:selected /template/ Border#PART_ItemBorder">
            <Setter Property="Background" Value="#4C5FD5" />
        </Style>

        <!-- Inline Taxonomy Editor AutoCompleteBox Specific Styling -->
        <Style Selector="AutoCompleteBox.InlineTaxonomyEditor">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="AutoCompleteBox.InlineTaxonomyEditor /template/ TextBox#PART_TextBox">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#4F46E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- TreeViewItem Two-Way IsExpanded Container Style -->
        <Style Selector="TreeViewItem" x:DataType="vm:HierarchyNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>

        <!-- TreeView Row Hover Actions -->
        <Style Selector="TreeViewItem StackPanel.tree-row-actions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TreeViewItem:pointerover StackPanel.tree-row-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TreeViewItem:selected StackPanel.tree-row-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#14171F" />
            <Setter Property="BorderBrush" Value="#323846" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <!-- NumericUpDown Styling -->
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="#252529" />
            <Setter Property="BorderBrush" Value="#333337" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Theme Button Styling -->
        <Style Selector="Button.theme-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#333337" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.theme-btn:pointerover">
            <Setter Property="Background" Value="#252529" />
        </Style>
        <Style Selector="Button.theme-btn.active">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="BorderBrush" Value="#4F46E5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.theme-btn.system-active">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="BorderBrush" Value="#D4AF37" />
            <Setter Property="Foreground" Value="#D4AF37" />
        </Style>

        <!-- Standard Button Styles -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#38383E" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#4338CA" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#DC2626" />
        </Style>

        <!-- Icon Action Button Styling -->
        <Style Selector="Button.action-icon-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="#94A3B8" />
        </Style>
        <Style Selector="Button.action-icon-btn:pointerover">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.danger-icon:pointerover">
            <Setter Property="Background" Value="#451A1A" />
            <Setter Property="Foreground" Value="#F87171" />
        </Style>

        <!-- Section Label Text -->
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </Window.Styles>

    <Border CornerRadius="10" Background="#1E1E22" BorderBrush="#333337" BorderThickness="1" ClipToBounds="True">
        <DockPanel LastChildFill="True">
            <!-- Header Bar -->
            <Grid DockPanel.Dock="Top" Height="48" Background="#1E1E22" PointerPressed="Header_PointerPressed">
                <TextBlock Text="Settings" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="#FFFFFF" 
                           VerticalAlignment="Center" 
                           Margin="16,0,0,0" />
                
                <Button Command="{Binding CloseDialogCommand}" 
                        CommandParameter="{Binding $parent[Window]}"
                        Background="Transparent" 
                        BorderThickness="0" 
                        Foreground="#AAAAAA" 
                        FontSize="16" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Margin="0,0,16,0"
                        Padding="4">
                    <TextBlock Text="✕" />
                </Button>
                
                <!-- Header Bottom Divider -->
                <Rectangle Height="1" Fill="#2A2A2E" VerticalAlignment="Bottom" />
            </Grid>

            <!-- Global Modal Footer Action Bar with Contextual Left Breadcrumb -->
            <Grid DockPanel.Dock="Bottom" Height="56" Background="#1E1E22">
                <!-- Footer Top Divider -->
                <Rectangle Height="1" Fill="#2A2A2E" VerticalAlignment="Top" />
                
                <!-- Left: Contextual Breadcrumb for Taxonomy -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Center" 
                            Spacing="6" 
                            Margin="20,0,0,0"
                            IsVisible="{Binding HasSelectedTaxonomyNode}">
                    <TextBlock Text="Path:" FontSize="12" Foreground="#717888" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedTaxonomyPath}" 
                               FontSize="12" 
                               Foreground="#9CA3AF" 
                               VerticalAlignment="Center" 
                               TextTrimming="CharacterEllipsis" 
                               MaxWidth="450" />
                </StackPanel>

                <!-- Right: Dialog Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12" Margin="0,0,16,0">
                    <Button Classes="secondary" 
                            Content="Discard Changes" 
                            Command="{Binding DiscardChangesCommand}" />
                    <Button Classes="primary" 
                            Content="Save Changes" 
                            Command="{Binding SaveSettingsCommand}" 
                            CommandParameter="{Binding $parent[Window]}" />
                </StackPanel>
            </Grid>

            <!-- Sidebar Navigation Column -->
            <Grid ColumnDefinitions="200,1,*">
                <ListBox Grid.Column="0" 
                         Classes="sidebar-list" 
                         SelectedIndex="{Binding SelectedTabIndex}">
                    <ListBoxItem Content="General" />
                    <ListBoxItem Content="Storage &amp; Paths" />
                    <ListBoxItem Content="Culling" />
                    <ListBoxItem Content="Color Labels" />
                    <ListBoxItem Content="Keyboard Shortcuts" />
                    <ListBoxItem Content="Keywords" />
                </ListBox>

                <!-- Vertical Divider -->
                <Rectangle Grid.Column="1" Width="1" Fill="#2A2A2E" />

                <!-- Content Area -->
                <ScrollViewer Grid.Column="2" Padding="24,16" VerticalScrollBarVisibility="Auto">
                    <Carousel SelectedIndex="{Binding SelectedTabIndex}">
                        <!-- View 0: General -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="GENERAL" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,4,0,4" LetterSpacing="1" />
                            
                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Active Theme Mode" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <UniformGrid Grid.Column="1" Columns="3" Height="36" Width="280" HorizontalAlignment="Right">
                                    <Button Classes="theme-btn" 
                                            Classes.active="{Binding IsLightActive}"
                                            Command="{Binding SetLightThemeCommand}"
                                            Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <material:MaterialIcon Kind="WhiteBalanceSunny" Width="14" Height="14" />
                                            <TextBlock Text="Light" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="theme-btn" 
                                            Classes.active="{Binding IsDarkActive}"
                                            Command="{Binding SetDarkThemeCommand}"
                                            Margin="4,0,4,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <material:MaterialIcon Kind="WeatherNight" Width="14" Height="14" />
                                            <TextBlock Text="Dark" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="theme-btn" 
                                            Classes.system-active="{Binding IsSystemActive}"
                                            Command="{Binding SetSystemThemeCommand}"
                                            Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <material:MaterialIcon Kind="Settings" Width="14" Height="14" />
                                            <TextBlock Text="System" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </Grid>

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Launch Application in Full Screen" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding LaunchFullScreen}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- View 1: Storage & Paths -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="STORAGE &amp; PATHS" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,4,0,4" LetterSpacing="1" />

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Library Location" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding LibraryLocation}" Watermark="Select Library Path" IsReadOnly="True" Height="36" Width="350" HorizontalAlignment="Right" VerticalContentAlignment="Center">
                                    <TextBox.InnerRightContent>
                                        <Button Command="{Binding BrowseLibraryLocationCommand}" Background="Transparent" BorderThickness="0" Padding="8,4">
                                            <material:MaterialIcon Kind="FolderOpenOutline" Foreground="#AAAAAA" Width="18" Height="18" />
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </Grid>

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Edit Destination Folder" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding EditFolderPath}" Watermark="Select Edit Destination Path" IsReadOnly="True" Height="36" Width="350" HorizontalAlignment="Right" VerticalContentAlignment="Center">
                                    <TextBox.InnerRightContent>
                                        <Button Command="{Binding BrowseEditFolderCommand}" Background="Transparent" BorderThickness="0" Padding="8,4">
                                            <material:MaterialIcon Kind="FolderOpenOutline" Foreground="#AAAAAA" Width="18" Height="18" />
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </Grid>

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Print Destination Folder" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding PrintFolderPath}" Watermark="Select Print Destination Path" IsReadOnly="True" Height="36" Width="350" HorizontalAlignment="Right" VerticalContentAlignment="Center">
                                    <TextBox.InnerRightContent>
                                        <Button Command="{Binding BrowsePrintFolderCommand}" Background="Transparent" BorderThickness="0" Padding="8,4">
                                            <material:MaterialIcon Kind="FolderOpenOutline" Foreground="#AAAAAA" Width="18" Height="18" />
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </Grid>
                        </StackPanel>

                        <!-- View 2: Culling -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="CULLING CRITERIA" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,4,0,4" LetterSpacing="1" />

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Grouping Threshold" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <NumericUpDown Grid.Column="1" Value="{Binding GroupingThreshold}" Minimum="1" Maximum="100" FormatString="0" Height="36" Width="150" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Burst Time Threshold (Seconds)" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <NumericUpDown Grid.Column="1" Value="{Binding BurstTimeThreshold}" Minimum="1" Maximum="60" FormatString="0" Height="36" Width="150" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Burst Fallback Time (Seconds)" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <NumericUpDown Grid.Column="1" Value="{Binding BurstFallbackThreshold}" Minimum="1" Maximum="120" FormatString="0" Height="36" Width="150" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- View 3: Color Labels -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="COLOR LABEL NAMES" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,4,0,4" LetterSpacing="1" />

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Red Color Label" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding RedLabelName}" Watermark="Red Label" Height="36" Width="250" HorizontalAlignment="Right" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#B71C1C" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Orange Color Label" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding OrangeLabelName}" Watermark="Orange Label" Height="36" Width="250" HorizontalAlignment="Right" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#E67E22" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Yellow Color Label" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding YellowLabelName}" Watermark="Yellow Label" Height="36" Width="250" HorizontalAlignment="Right" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#FDD835" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Green Color Label" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding GreenLabelName}" Watermark="Green Label" Height="36" Width="250" HorizontalAlignment="Right" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#33CC33" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Blue Color Label" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding BlueLabelName}" Watermark="Blue Label" Height="36" Width="250" HorizontalAlignment="Right" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#3333CC" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Pink Color Label" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding PinkLabelName}" Watermark="Pink Label" Height="36" Width="250" HorizontalAlignment="Right" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#F06292" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>

                            <Grid ColumnDefinitions="*, 350" Height="40">
                                <TextBlock Text="Purple Color Label" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                <TextBox Grid.Column="1" Text="{Binding PurpleLabelName}" Watermark="Purple Label" Height="36" Width="250" HorizontalAlignment="Right" VerticalContentAlignment="Center">
                                    <TextBox.InnerLeftContent>
                                        <material:MaterialIcon Kind="Circle" Foreground="#CC33CC" Width="14" Height="14" Margin="10,0,0,0" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>
                        </StackPanel>

                        <!-- View 4: Keyboard Shortcuts -->
                        <StackPanel Spacing="16">
                            <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <!-- General shortcuts -->
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="GENERAL" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,4,0,4" LetterSpacing="1" />
                                        
                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Toggle Fullscreen Mode" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Fullscreen" Text="{Binding FullscreenShortcut, Mode=TwoWay}" Watermark="Fullscreen" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Open File in Explorer" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="OpenInExplorer" Text="{Binding OpenInExplorerShortcut, Mode=TwoWay}" Watermark="Open in Explorer" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Copy File to Edits" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="CopyToEdit" Text="{Binding CopyToEditShortcut, Mode=TwoWay}" Watermark="Ctrl+E" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Copy File to Print" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="CopyToPrint" Text="{Binding CopyToPrintShortcut, Mode=TwoWay}" Watermark="Shift+E" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Color assignment shortcuts -->
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="COLORS" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,4,0,4" LetterSpacing="1" />

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Assign Red Color Tag" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Red" Text="{Binding RedLabelShortcut, Mode=TwoWay}" Watermark="None" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Assign Orange Color Tag" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Orange" Text="{Binding OrangeLabelShortcut, Mode=TwoWay}" Watermark="None" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Assign Yellow Color Tag" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Yellow" Text="{Binding YellowLabelShortcut, Mode=TwoWay}" Watermark="None" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Assign Green Color Tag" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Green" Text="{Binding GreenLabelShortcut, Mode=TwoWay}" Watermark="None" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Assign Blue Color Tag" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Blue" Text="{Binding BlueLabelShortcut, Mode=TwoWay}" Watermark="None" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Assign Pink Color Tag" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Pink" Text="{Binding PinkLabelShortcut, Mode=TwoWay}" Watermark="None" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Assign Purple Color Tag" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Purple" Text="{Binding PurpleLabelShortcut, Mode=TwoWay}" Watermark="None" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Clear Color Tag" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="None" Text="{Binding NoneLabelShortcut, Mode=TwoWay}" Watermark="None" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Ratings shortcuts -->
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="STARS" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,4,0,4" LetterSpacing="1" />

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Set Star Rating to 1" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Rating1" Text="{Binding Rating1Shortcut, Mode=TwoWay}" Watermark="1 Star" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Set Star Rating to 2" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Rating2" Text="{Binding Rating2Shortcut, Mode=TwoWay}" Watermark="2 Stars" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Set Star Rating to 3" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Rating3" Text="{Binding Rating3Shortcut, Mode=TwoWay}" Watermark="3 Stars" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Set Star Rating to 4" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Rating4" Text="{Binding Rating4Shortcut, Mode=TwoWay}" Watermark="4 Stars" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Set Star Rating to 5" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Rating5" Text="{Binding Rating5Shortcut, Mode=TwoWay}" Watermark="5 Stars" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Clear Star Rating" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="Rating0" Text="{Binding Rating0Shortcut, Mode=TwoWay}" Watermark="0 Stars / None" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Curation shortcuts -->
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="CURATION STATUS" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,4,0,4" LetterSpacing="1" />

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Mark Image as Picked" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="CurationPicked" Text="{Binding CurationPickedShortcut, Mode=TwoWay}" Watermark="Picked" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Mark Image as Rejected" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="CurationRejected" Text="{Binding CurationRejectedShortcut, Mode=TwoWay}" Watermark="Rejected" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 350" Height="40">
                                            <TextBlock Text="Set Curation Status to Neutral" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" />
                                            <TextBox Grid.Column="1" Tag="CurationNeutral" Text="{Binding CurationNeutralShortcut, Mode=TwoWay}" Watermark="Neutral" Height="36" Width="250" HorizontalAlignment="Right" IsReadOnly="True" KeyDown="OnShortcutKeyDown" VerticalContentAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- View 5: Keywords / Tagging Settings (Refactored Sub-Tabbed Interface) -->
                        <Grid RowDefinitions="Auto,*" Height="460">
                            <!-- Keywords Sub-Tab Navigation Header -->
                            <Border Grid.Row="0" Background="#14171F" CornerRadius="8" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Classes="subtab-btn" 
                                            Classes.active="{Binding IsTagsSubTabActive}"
                                            Command="{Binding SelectTagsSubTabCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="TagMultipleOutline" Width="14" Height="14" />
                                            <TextBlock Text="Tags" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="subtab-btn" 
                                            Classes.active="{Binding IsTaxonomySubTabActive}"
                                            Command="{Binding SelectTaxonomySubTabCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="FileTreeOutline" Width="14" Height="14" />
                                            <TextBlock Text="Taxonomy" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="subtab-btn" 
                                            Classes.active="{Binding IsGroupsSubTabActive}"
                                            Command="{Binding SelectGroupsSubTabCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="BookmarkMultipleOutline" Width="14" Height="14" />
                                            <TextBlock Text="Groups" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Sub-Tab Content Carousel -->
                            <Carousel Grid.Row="1" SelectedIndex="{Binding KeywordsSubTabIndex}">

                                <!-- ══════════════════════════════════════════════════════════════════════ -->
                                <!-- SUB-TAB 0: TAGS (CATALOG) -->
                                <!-- ══════════════════════════════════════════════════════════════════════ -->
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <!-- Top Inline Entry Field -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*, 8, Auto" Margin="0,0,0,12">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding NewTagName, Mode=TwoWay}"
                                                 Height="36"
                                                 VerticalContentAlignment="Center"
                                                 Watermark="New tag name... (Press Enter to add)"
                                                 Background="#14171F"
                                                 BorderBrush="#323846"
                                                 Foreground="#F8FAFC">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Return" Command="{Binding AddTagCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <Button Grid.Column="2" 
                                                Command="{Binding AddTagCommand}" 
                                                Height="36" 
                                                Classes="primary" 
                                                Content="+ Add Tag" />
                                    </Grid>

                                    <!-- Tags Catalog ListBox -->
                                    <Border Grid.Row="1" Background="#14171F" CornerRadius="8" BorderThickness="1" BorderBrush="#323846" Padding="6" MinHeight="260" MaxHeight="320">
                                        <ListBox ItemsSource="{Binding Tags}"
                                                 Background="Transparent"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="vm:TagItemViewModel">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="2,1">
                                                        <!-- Tag Icon -->
                                                        <material:MaterialIcon Grid.Column="0" Kind="TagOutline" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,8,0" />

                                                        <!-- Normal View: Display Name -->
                                                        <TextBlock Grid.Column="1" 
                                                                   Text="{Binding Name}" 
                                                                   VerticalAlignment="Center" 
                                                                   FontSize="13" 
                                                                   Foreground="#E2E8F0" 
                                                                   IsVisible="{Binding !IsEditing}" />

                                                        <!-- Edit View: Inline TextBox -->
                                                        <TextBox Grid.Column="1" 
                                                                 Text="{Binding EditingName, Mode=TwoWay}" 
                                                                 Height="30" 
                                                                 Padding="6,3" 
                                                                 FontSize="13" 
                                                                 Background="#1E293B" 
                                                                 BorderBrush="#4F46E5" 
                                                                 Foreground="#FFFFFF" 
                                                                 VerticalContentAlignment="Center" 
                                                                 IsVisible="{Binding IsEditing}">
                                                            <TextBox.KeyBindings>
                                                                <KeyBinding Gesture="Return" Command="{Binding CommitEditCommand}" />
                                                                <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
                                                            </TextBox.KeyBindings>
                                                        </TextBox>

                                                        <!-- Action Buttons (Normal State) -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsEditing}">
                                                            <Button Classes="action-icon-btn" Command="{Binding StartEditCommand}" ToolTip.Tip="Rename Tag">
                                                                <material:MaterialIcon Kind="PencilOutline" Width="15" Height="15" />
                                                            </Button>
                                                            <Button Classes="action-icon-btn danger-icon" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete Tag">
                                                                <material:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" />
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- Action Buttons (Edit State) -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsEditing}">
                                                            <Button Classes="action-icon-btn" Command="{Binding CommitEditCommand}" ToolTip.Tip="Save">
                                                                <material:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="#22C55E" />
                                                            </Button>
                                                            <Button Classes="action-icon-btn" Command="{Binding CancelEditCommand}" ToolTip.Tip="Cancel">
                                                                <material:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="#EF4444" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="CornerRadius" Value="6" />
                                                    <Setter Property="Padding" Value="8,4" />
                                                    <Setter Property="Margin" Value="0,0,0,3" />
                                                    <Setter Property="Background" Value="#1A1F2C" />
                                                </Style>
                                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="#242B3D" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="#1E293B" />
                                                </Style>
                                            </ListBox.Styles>
                                        </ListBox>
                                    </Border>

                                    <!-- Delete Confirmation Card Overlay (when tag in use is deleted) -->
                                    <Border Grid.Row="0" Grid.RowSpan="2" 
                                            Background="#EE14171F" 
                                            CornerRadius="8" 
                                            Padding="24" 
                                            IsVisible="{Binding IsDeleteTagConfirmOpen}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            MaxWidth="480"
                                            BorderBrush="#EF4444"
                                            BorderThickness="1">
                                        <StackPanel Spacing="14">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <material:MaterialIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#EF4444" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DeleteTagConfirmTitle}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding DeleteTagConfirmMessage}" TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="13" LineHeight="18" />

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                                                <Button Classes="secondary" Content="Cancel" Command="{Binding CancelDeleteTagCommand}" Height="34" />
                                                <Button Classes="danger" Content="Delete &amp; Unlink" Command="{Binding ConfirmDeleteTagCommand}" Height="34" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>


                                <!-- ══════════════════════════════════════════════════════════════════════ -->
                                <!-- SUB-TAB 1: TAXONOMY (HIERARCHY) - CLEAN DIRECT TREE INTERACTION -->
                                <!-- ══════════════════════════════════════════════════════════════════════ -->
                                <Grid RowDefinitions="Auto,*" Margin="0,0,0,0">
                                    <!-- Clean Header Bar with Single '+ Add Root' Action Button -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,0,8">
                                        <TextBlock Grid.Column="0" Text="TAXONOMY HIERARCHY" Foreground="#888888" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" LetterSpacing="1" />
                                        
                                        <Button Grid.Column="1" 
                                                Classes="secondary" 
                                                Height="28" 
                                                Padding="10,2" 
                                                FontSize="11" 
                                                Command="{Binding AddRootNodeCommand}"
                                                ToolTip.Tip="Add root category (Press Enter to commit)">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <material:MaterialIcon Kind="FolderPlusOutline" Width="13" Height="13" Foreground="#A78BFA" />
                                                <TextBlock Text="+ Add Root" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Clean TreeView Container (No inside footer) -->
                                    <Border Grid.Row="1" Background="#14171F" CornerRadius="6" BorderThickness="1" BorderBrush="#323846" Padding="6" MinHeight="260" MaxHeight="330">
                                        <TreeView ItemsSource="{Binding HierarchyNodes}" 
                                                  SelectedItem="{Binding SelectedHierarchyNode, Mode=TwoWay}" 
                                                  Background="Transparent" 
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <TreeView.Styles>
                                                <Style Selector="TreeViewItem" x:DataType="vm:HierarchyNodeViewModel">
                                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                </Style>
                                            </TreeView.Styles>
                                            <TreeView.KeyBindings>
                                                <KeyBinding Gesture="F2" Command="{Binding StartEditSelectedNodeCommand}" />
                                                <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedNodeCommand}" />
                                            </TreeView.KeyBindings>
                                            <TreeView.ItemTemplate>
                                                <TreeDataTemplate DataType="vm:HierarchyNodeViewModel" ItemsSource="{Binding Children}">
                                                    <Panel Margin="0,2">
                                                        <!-- Normal Display Mode -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}">
                                                            <!-- Folder / Node Icon -->
                                                            <material:MaterialIcon Grid.Column="0" Kind="FolderOutline" Width="15" Height="15" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />

                                                            <!-- Normal View: TextBlock -->
                                                            <TextBlock Grid.Column="1" 
                                                                       Text="{Binding Name}" 
                                                                       FontSize="13" 
                                                                       Foreground="#E2E8F0" 
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.ContextMenu>
                                                                    <ContextMenu Background="#1E1E22" BorderBrush="#333337" BorderThickness="1">
                                                                        <MenuItem Header="Add Sub-Node" Command="{Binding $parent[TreeView].((vm:SettingsDialogViewModel)DataContext).AddSubNodeCommand}" CommandParameter="{Binding}" />
                                                                        <MenuItem Header="Rename" Command="{Binding StartEditCommand}" InputGesture="F2" />
                                                                        <MenuItem Header="Create Group from Branch" Command="{Binding $parent[TreeView].((vm:SettingsDialogViewModel)DataContext).CreateGroupFromTaxonomyNodeCommand}" CommandParameter="{Binding}" />
                                                                        <Separator />
                                                                        <MenuItem Header="Delete" Command="{Binding $parent[TreeView].((vm:SettingsDialogViewModel)DataContext).DeleteNodeCommand}" CommandParameter="{Binding}" InputGesture="Delete" Foreground="#EF4444" />
                                                                    </ContextMenu>
                                                                </TextBlock.ContextMenu>
                                                            </TextBlock>

                                                            <!-- Row Hover Action Buttons (Visible on PointerOver / Selected) -->
                                                            <StackPanel Grid.Column="2" 
                                                                        Classes="tree-row-actions" 
                                                                        Orientation="Horizontal" 
                                                                        Spacing="4" 
                                                                        HorizontalAlignment="Right" 
                                                                        VerticalAlignment="Center"
                                                                        Margin="8,0,4,0">
                                                                <Button Classes="action-icon-btn" 
                                                                        Command="{Binding $parent[TreeView].((vm:SettingsDialogViewModel)DataContext).AddSubNodeCommand}" 
                                                                        CommandParameter="{Binding}" 
                                                                        ToolTip.Tip="Add Sub-Node">
                                                                    <material:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="#38BDF8" />
                                                                </Button>
                                                                <Button Classes="action-icon-btn danger-icon" 
                                                                        Command="{Binding $parent[TreeView].((vm:SettingsDialogViewModel)DataContext).DeleteNodeCommand}" 
                                                                        CommandParameter="{Binding}" 
                                                                        ToolTip.Tip="Delete Node (Delete)">
                                                                    <material:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#EF4444" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Inline Edit Mode -->
                                                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" IsVisible="{Binding IsEditing}">
                                                            <!-- Folder / Node Icon -->
                                                            <material:MaterialIcon Grid.Column="0" Kind="FolderOutline" Width="15" Height="15" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />

                                                            <!-- AutoCompleteBox for typing/selecting tag name -->
                                                            <AutoCompleteBox Grid.Column="1" 
                                                                             Classes="InlineTaxonomyEditor"
                                                                             ItemsSource="{Binding $parent[TreeView].((vm:SettingsDialogViewModel)DataContext).TagSuggestions}"
                                                                             Text="{Binding EditingName, Mode=TwoWay}"
                                                                             FilterMode="ContainsOrdinal"
                                                                             MinimumPrefixLength="0"
                                                                             MinimumPopulateDelay="00:00:00"
                                                                             GotFocus="OnInlineAutoCompleteGotFocus"
                                                                             AttachedToVisualTree="OnInlineAutoCompleteAttached"
                                                                             Watermark="Select or type tag..."
                                                                             Margin="2,0,0,0"
                                                                             VerticalAlignment="Center">
                                                                <AutoCompleteBox.ItemTemplate>
                                                                    <DataTemplate DataType="x:String">
                                                                        <TextBlock Text="{Binding}" 
                                                                                   FontSize="13" 
                                                                                   Foreground="#FFFFFF" 
                                                                                   VerticalAlignment="Center" />
                                                                    </DataTemplate>
                                                                </AutoCompleteBox.ItemTemplate>
                                                                <AutoCompleteBox.KeyBindings>
                                                                    <KeyBinding Gesture="Return" Command="{Binding CommitEditCommand}" />
                                                                    <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
                                                                </AutoCompleteBox.KeyBindings>
                                                            </AutoCompleteBox>
                                                        </Grid>
                                                    </Panel>
                                                </TreeDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </Border>
                                </Grid>


                                <!-- ══════════════════════════════════════════════════════════════════════ -->
                                <!-- SUB-TAB 2: GROUPS (PRESETS & TAXONOMY MIRRORING) -->
                                <!-- ══════════════════════════════════════════════════════════════════════ -->
                                <Grid ColumnDefinitions="240,14,*">
                                    <!-- Left Column: Master List of Groups -->
                                    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Row="0" Text="GROUPS" Foreground="#888888" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" LetterSpacing="1" Margin="2,0,0,8" />

                                        <Border Grid.Row="1" Background="#14171F" CornerRadius="6" BorderThickness="1" BorderBrush="#323846" Padding="4" MinHeight="220" MaxHeight="250">
                                            <ListBox ItemsSource="{Binding TagGroups}"
                                                     SelectedItem="{Binding SelectedTagGroup, Mode=TwoWay}"
                                                     Background="Transparent"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="models:TagGroup">
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <material:MaterialIcon Kind="BookmarkOutline" Width="14" Height="14" Foreground="#818CF8" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding GroupName}" FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <Button Grid.Column="1" 
                                                                    Classes="action-icon-btn danger-icon" 
                                                                    Command="{Binding $parent[ListBox].((vm:SettingsDialogViewModel)DataContext).DeleteTagGroupCommand}" 
                                                                    CommandParameter="{Binding}" 
                                                                    ToolTip.Tip="Delete Group">
                                                                <material:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                                <ListBox.Styles>
                                                    <Style Selector="ListBoxItem">
                                                        <Setter Property="CornerRadius" Value="6" />
                                                        <Setter Property="Padding" Value="8,5" />
                                                        <Setter Property="Margin" Value="0,0,0,2" />
                                                    </Style>
                                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                                        <Setter Property="Background" Value="#38383E" />
                                                    </Style>
                                                </ListBox.Styles>
                                            </ListBox>
                                        </Border>

                                        <!-- Add Group Bottom Creation Bar (Branch ComboBox + Name Input + Add Button) -->
                                        <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                                            <ComboBox ItemsSource="{Binding AvailableTaxonomyBranches}"
                                                      SelectedItem="{Binding SelectedTaxonomyBranch, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="Or import branch..."
                                                      Height="30"
                                                      FontSize="11" />
                                            <Grid ColumnDefinitions="*,6,Auto">
                                                <TextBox Grid.Column="0" 
                                                         Text="{Binding NewTagGroupName, Mode=TwoWay}" 
                                                         Watermark="New group name..." 
                                                         Height="32" 
                                                         VerticalContentAlignment="Center" 
                                                         Background="#14171F" 
                                                         BorderBrush="#323846" 
                                                         Foreground="#F8FAFC"
                                                         Padding="8,4"
                                                         FontSize="12">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Return" Command="{Binding AddTagGroupCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <Button Grid.Column="2" 
                                                        Command="{Binding AddTagGroupCommand}" 
                                                        Height="32" 
                                                        Padding="12,4" 
                                                        Classes="primary" 
                                                        Content="Add" 
                                                        FontSize="12" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Right Column: Detail Content of Selected Group -->
                                    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" IsEnabled="{Binding SelectedTagGroup, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <!-- Group Header -->
                                        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
                                            <TextBlock Text="TAGS IN GROUP" Foreground="#888888" FontSize="11" FontWeight="Bold" LetterSpacing="1" />
                                            <TextBlock Text="{Binding SelectedTagGroup.GroupName, StringFormat='Editing: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </StackPanel>

                                        <!-- Chips / Badges Area -->
                                        <Border Grid.Row="1" Background="#14171F" BorderBrush="#2A2E39" BorderThickness="1" CornerRadius="6" Padding="8" MinHeight="190" MaxHeight="240">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding SelectedGroupTags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="models:Tag">
                                                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="16" Padding="10,4" Margin="0,0,6,6">
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <material:MaterialIcon Kind="Tag" Width="12" Height="12" Foreground="#818CF8" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Name}" Foreground="#E2E8F0" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                                                    <Button Command="{Binding $parent[ItemsControl].((vm:SettingsDialogViewModel)DataContext).RemoveTagFromGroupCommand}" 
                                                                            CommandParameter="{Binding}" 
                                                                            Background="Transparent" 
                                                                            BorderThickness="0" 
                                                                            Padding="2" 
                                                                            ToolTip.Tip="Remove tag from group">
                                                                        <material:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="#EF4444" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Autocomplete Tag Entry -->
                                        <Grid Grid.Row="2" ColumnDefinitions="*,8,Auto" Margin="0,8,0,0">
                                            <AutoCompleteBox Grid.Column="0"
                                                             ItemsSource="{Binding TagSuggestions}"
                                                             Text="{Binding NewGroupTagInput, Mode=TwoWay}"
                                                             Watermark="Type tag to add (Press Enter)..."
                                                             FilterMode="ContainsOrdinal"
                                                             Height="34"
                                                             Padding="8,4"
                                                             FontSize="12">
                                                <AutoCompleteBox.KeyBindings>
                                                    <KeyBinding Gesture="Return" Command="{Binding AddTagToSelectedGroupCommand}" />
                                                </AutoCompleteBox.KeyBindings>
                                            </AutoCompleteBox>

                                            <Button Grid.Column="2" 
                                                    Command="{Binding AddTagToSelectedGroupCommand}" 
                                                    Height="34" 
                                                    Classes="primary" 
                                                    Content="+ Add Tag" 
                                                    FontSize="12" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Carousel>
                        </Grid>
                    </Carousel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
