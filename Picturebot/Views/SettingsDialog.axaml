<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Picturebot.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:icons="using:Material.Icons"
             x:DataType="vm:SettingsDialogViewModel"
             x:Class="Picturebot.Views.SettingsDialog"
             Width="520">

    <StackPanel Spacing="24">

        <TextBlock Text="Settings"
                   FontSize="22"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

        <StackPanel Spacing="10">
            <TextBlock Text="THEME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SukiLowText}"
                       LetterSpacing="1" />
            <UniformGrid Columns="3" Height="45">
                <Button Command="{Binding SetLightThemeCommand}"
                        Classes.Accent="{Binding IsLightActive}"
                        Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="{x:Static icons:MaterialIconKind.WhiteBalanceSunny}"
                                               Width="18" Height="18" />
                        <TextBlock Text="Light" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetDarkThemeCommand}"
                        Classes.Accent="{Binding IsDarkActive}"
                        Margin="4,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="{x:Static icons:MaterialIconKind.WeatherNight}" Width="18"
                                               Height="18" />
                        <TextBlock Text="Dark" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetSystemThemeCommand}"
                        Classes.Accent="{Binding IsSystemActive}"
                        Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="{x:Static icons:MaterialIconKind.Settings}" Width="18"
                                               Height="18" />
                        <TextBlock Text="System" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="LIBRARY LOCATION" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource SukiLowText}" LetterSpacing="1" />
            <DockPanel LastChildFill="True">
                <Button Command="{Binding BrowseLibraryLocationCommand}"
                        Content="Browse"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Padding="16,0" />
                <TextBox Text="{Binding LibraryLocation}"
                         Watermark="This folder will be used to store your albums"
                         Height="40"
                         VerticalContentAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="CLUSTER THRESHOLD" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource SukiLowText}" LetterSpacing="1" />
            <NumericUpDown Value="{Binding ClusterThreshold}"
                           Minimum="1"
                           Maximum="100"
                           FormatString="0"
                           HorizontalAlignment="Left"
                           Width="120"
                           Height="40" />
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="BURST TIME THRESHOLD (SECONDS)" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource SukiLowText}" LetterSpacing="1" />
            <NumericUpDown Value="{Binding BurstTimeThreshold}"
                           Minimum="1"
                           Maximum="60"
                           FormatString="0"
                           HorizontalAlignment="Left"
                           Width="120"
                           Height="40" />
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="BURST FALLBACK TIME (SECONDS)" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource SukiLowText}" LetterSpacing="1" />
            <NumericUpDown Value="{Binding BurstFallbackThreshold}"
                           Minimum="1"
                           Maximum="120"
                           FormatString="0"
                           HorizontalAlignment="Left"
                           Width="120"
                           Height="40" />
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="BURST HASH THRESHOLD" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource SukiLowText}" LetterSpacing="1" />
            <NumericUpDown Value="{Binding BurstHashThreshold}"
                           Minimum="1"
                           Maximum="64"
                           FormatString="0"
                           HorizontalAlignment="Left"
                           Width="120"
                           Height="40" />
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="WINDOW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SukiLowText}"
                       LetterSpacing="1" />
            <CheckBox IsChecked="{Binding LaunchFullScreen}"
                      Content="Launch Full Screen"
                      FontSize="14" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
            <Button Command="{Binding CloseDialogCommand}"
                    Content="Cancel"
                    Classes.Accent="False"
                    Width="100"
                    Height="40" />
            <Button Command="{Binding SaveSettingsCommand}"
                    Content="Save"
                    Classes.Accent="True"
                    Width="100"
                    Height="40" />
        </StackPanel>

    </StackPanel>
</UserControl>
