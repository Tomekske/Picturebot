<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Picturebot.Views.StatusBarView"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Picturebot.ViewModels"
             xmlns:views="using:Picturebot.Views"
             x:DataType="vm:StatusBarViewModel">

    <Grid ColumnDefinitions="Auto, *">
        <!-- Settings Button on the left -->
        <Button Grid.Column="0"
                Command="{Binding OpenSettingsCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="5,0,0,0"
                Background="Transparent"
                BorderThickness="0"
                Width="24"
                Height="24"
                ToolTip.Tip="Settings"
                CornerRadius="4"
                Padding="0">
            <ic:SymbolIcon Symbol="Settings" FontSize="14" Foreground="#888888" />
        </Button>

        <!-- Status items aligned to the bottom-right -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Margin="0,0,10,0">

            <!-- Sync Status -->
            <views:SyncStatusView DataContext="{Binding SyncStatusVM}" />

            <Separator Width="1" Height="14" Background="#3f3f3f" />

            <!-- DEV Badge (Visible only in non-Production environments) -->
            <Border IsVisible="{Binding ShowDevBadge}"
                    Background="#e67e22"
                    CornerRadius="3"
                    Padding="6,2">
                <TextBlock Text="DEV"
                           FontSize="10"
                           FontWeight="Black"
                           Foreground="White" />
            </Border>

            <!-- Version Indicator -->
            <Border Background="#1e1e1e"
                    BorderBrush="#3f3f3f"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,2">
                <TextBlock Text="{Binding AppVersion}"
                           FontSize="11"
                           FontFamily="Consolas, Monospace"
                           Foreground="#cccccc" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
