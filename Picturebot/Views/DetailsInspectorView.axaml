<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Picturebot.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:converters="using:Picturebot.Converters"
             xmlns:enums="using:Domain.Enums"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="800"
             x:Class="Picturebot.Views.DetailsInspectorView"
             x:DataType="vm:DetailsInspectorViewModel">

    <UserControl.Resources>
        <converters:CurationStatusToBrushConverter x:Key="CurationStatusToBrushConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *, Auto" Margin="15">
        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Details"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Foreground="{DynamicResource SukiText}" />

        <!-- Main Content (Preview + Curation) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="25">
                <!-- Preview Box -->
                <suki:GlassCard Padding="0" ClipToBounds="True">
                    <Panel Background="#151515" MinHeight="200">
                        <!-- Fade-in Image Logic -->
                        <Image Source="{Binding PreviewImage}"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Classes.loaded="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Image.Styles>
                                <Style Selector="Image">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <DoubleTransition Property="Opacity"
                                                              Duration="0:0:0.6"
                                                              Easing="QuadraticEaseOut" />
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="Image.loaded">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </Image.Styles>
                        </Image>

                        <!-- Empty State -->
                        <StackPanel IsVisible="{Binding SelectedPicture, Converter={x:Static ObjectConverters.IsNull}}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="10">
                            <icons:MaterialIcon Kind="ImageOutline" Width="48" Height="48"
                                                Foreground="{DynamicResource SukiLowText}" />
                            <TextBlock Text="Select an asset to view details"
                                       Foreground="{DynamicResource SukiLowText}"
                                       FontSize="12" />
                        </StackPanel>
                    </Panel>
                </suki:GlassCard>

                <!-- Curation Section -->
                <StackPanel Spacing="15"
                            IsVisible="{Binding SelectedPicture, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="Curation Status"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SukiText}" />

                    <Grid ColumnDefinitions="*,*,*" HorizontalAlignment="Center">
                        <!-- Flagged -->
                        <Button Grid.Column="0" Classes="Basic"
                                Command="{Binding SetCurationStatusCommand}"
                                CommandParameter="{x:Static enums:CurationStatus.Flagged}"
                                Padding="10">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <icons:MaterialIcon Kind="Flag" Width="32" Height="32"
                                                    Foreground="{Binding SelectedPicture.CurationStatus, Converter={StaticResource CurationStatusToBrushConverter}, ConverterParameter=Flagged}" />
                                <TextBlock Text="Flagged" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Unflagged -->
                        <Button Grid.Column="1" Classes="Basic"
                                Command="{Binding SetCurationStatusCommand}"
                                CommandParameter="{x:Static enums:CurationStatus.Unflagged}"
                                Padding="10">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <icons:MaterialIcon Kind="CircleOutline" Width="32" Height="32"
                                                    Foreground="{Binding SelectedPicture.CurationStatus, Converter={StaticResource CurationStatusToBrushConverter}, ConverterParameter=Unflagged}" />
                                <TextBlock Text="Neutral" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Rejected -->
                        <Button Grid.Column="2" Classes="Basic"
                                Command="{Binding SetCurationStatusCommand}"
                                CommandParameter="{x:Static enums:CurationStatus.Rejected}"
                                Padding="10">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <icons:MaterialIcon Kind="Close" Width="32" Height="32"
                                                    Foreground="{Binding SelectedPicture.CurationStatus, Converter={StaticResource CurationStatusToBrushConverter}, ConverterParameter=Rejected}" />
                                <TextBlock Text="Rejected" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Spacing="10" Margin="0,20,0,0"
                    IsVisible="{Binding SelectedPicture, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Button Classes="Primary"
                    Command="{Binding EditMetadataCommand}"
                    HorizontalAlignment="Stretch"
                    Height="40">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="Pencil" Width="18" Height="18" />
                    <TextBlock Text="Edit" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button Classes="Accent"
                    Command="{Binding DeleteAssetCommand}"
                    HorizontalAlignment="Stretch"
                    Height="40"
                    Background="#CC3333">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="Delete" Width="18" Height="18" />
                    <TextBlock Text="Delete" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
