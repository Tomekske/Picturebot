<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Picturebot.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:converters="using:Picturebot.Converters"
             xmlns:enums="using:Domain.Enums"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="800"
             x:Class="Picturebot.Views.DetailsInspectorView"
             x:DataType="vm:DetailsInspectorViewModel">

    <UserControl.Resources>
        <converters:CurationStatusToBrushConverter x:Key="CurationStatusToBrushConverter" />
        <converters:ColorLabelToBrushConverter x:Key="ColorLabelToBrushConverter" />
        <converters:RatingToBrushConverter x:Key="RatingToBrushConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *, Auto" Margin="0,40,0,0">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="15,10">
            <TextBlock Text="Details"
                       Classes="h3"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SukiText}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" />
        </Grid>

        <!-- Main Content (Preview + Curation) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="15,0">
            <StackPanel Spacing="25">
                <!-- Preview Box -->
                <suki:GlassCard Padding="0" ClipToBounds="True">
                    <Panel Background="#151515" MinHeight="200">
                        <!-- Fade-in Image Logic -->
                        <Image Source="{Binding PreviewImage}"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Classes.loaded="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Image.Styles>
                                <Style Selector="Image">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <DoubleTransition Property="Opacity"
                                                              Duration="0:0:0.6"
                                                              Easing="QuadraticEaseOut" />
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="Image.loaded">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </Image.Styles>
                        </Image>

                        <!-- Empty State -->
                        <StackPanel IsVisible="{Binding SelectedPicture, Converter={x:Static ObjectConverters.IsNull}}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="10">
                            <icons:MaterialIcon Kind="ImageOutline" Width="48" Height="48"
                                                Foreground="{DynamicResource SukiLowText}" />
                            <TextBlock Text="Select an asset to view details"
                                       Foreground="{DynamicResource SukiLowText}"
                                       FontSize="12" />
                        </StackPanel>
                    </Panel>
                </suki:GlassCard>

                <!-- Curation Section -->
                <StackPanel Spacing="15"
                            IsVisible="{Binding SelectedPicture, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="Curation Status"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SukiText}" />

                    <Grid ColumnDefinitions="*,*,*" HorizontalAlignment="Center">
                        <!-- Flagged -->
                        <Button Grid.Column="0" Classes="Basic"
                                Command="{Binding SetCurationStatusCommand}"
                                CommandParameter="{x:Static enums:CurationStatus.Flagged}"
                                Padding="10">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <icons:MaterialIcon Kind="Flag" Width="32" Height="32"
                                                    Foreground="{Binding SelectedPicture.CurationStatus, Converter={StaticResource CurationStatusToBrushConverter}, ConverterParameter=Flagged}" />
                                <TextBlock Text="Flagged" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Unflagged -->
                        <Button Grid.Column="1" Classes="Basic"
                                Command="{Binding SetCurationStatusCommand}"
                                CommandParameter="{x:Static enums:CurationStatus.Unflagged}"
                                Padding="10">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <icons:MaterialIcon Kind="CircleOutline" Width="32" Height="32"
                                                    Foreground="{Binding SelectedPicture.CurationStatus, Converter={StaticResource CurationStatusToBrushConverter}, ConverterParameter=Unflagged}" />
                                <TextBlock Text="Neutral" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Rejected -->
                        <Button Grid.Column="2" Classes="Basic"
                                Command="{Binding SetCurationStatusCommand}"
                                CommandParameter="{x:Static enums:CurationStatus.Rejected}"
                                Padding="10">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <icons:MaterialIcon Kind="Close" Width="32" Height="32"
                                                    Foreground="{Binding SelectedPicture.CurationStatus, Converter={StaticResource CurationStatusToBrushConverter}, ConverterParameter=Rejected}" />
                                <TextBlock Text="Rejected" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Rating Section -->
                <StackPanel Spacing="10" IsVisible="{Binding SelectedPicture, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="Rating"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SukiText}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                        <Button Classes="Basic" Command="{Binding SetRatingCommand}" CommandParameter="1" Padding="2">
                            <icons:MaterialIcon Kind="Star" Width="28" Height="28" 
                                                Foreground="{Binding SelectedPicture.Rating, Converter={StaticResource RatingToBrushConverter}, ConverterParameter=1}" />
                        </Button>
                        <Button Classes="Basic" Command="{Binding SetRatingCommand}" CommandParameter="2" Padding="2">
                            <icons:MaterialIcon Kind="Star" Width="28" Height="28" 
                                                Foreground="{Binding SelectedPicture.Rating, Converter={StaticResource RatingToBrushConverter}, ConverterParameter=2}" />
                        </Button>
                        <Button Classes="Basic" Command="{Binding SetRatingCommand}" CommandParameter="3" Padding="2">
                            <icons:MaterialIcon Kind="Star" Width="28" Height="28" 
                                                Foreground="{Binding SelectedPicture.Rating, Converter={StaticResource RatingToBrushConverter}, ConverterParameter=3}" />
                        </Button>
                        <Button Classes="Basic" Command="{Binding SetRatingCommand}" CommandParameter="4" Padding="2">
                            <icons:MaterialIcon Kind="Star" Width="28" Height="28" 
                                                Foreground="{Binding SelectedPicture.Rating, Converter={StaticResource RatingToBrushConverter}, ConverterParameter=4}" />
                        </Button>
                        <Button Classes="Basic" Command="{Binding SetRatingCommand}" CommandParameter="5" Padding="2">
                            <icons:MaterialIcon Kind="Star" Width="28" Height="28" 
                                                Foreground="{Binding SelectedPicture.Rating, Converter={StaticResource RatingToBrushConverter}, ConverterParameter=5}" />
                        </Button>
                        <Button Classes="Basic" Command="{Binding SetRatingCommand}" CommandParameter="0" Padding="2" Margin="10,0,0,0">
                            <icons:MaterialIcon Kind="StarOff" Width="22" Height="22" Foreground="{DynamicResource SukiLowText}" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Color Label Section -->
                <StackPanel Spacing="10" IsVisible="{Binding SelectedPicture, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="Color Label"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SukiText}" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ColorLabelOptions}"
                              SelectedItem="{Binding SelectedColorLabelOption}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColorLabelOption">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="12" Height="12" Fill="{Binding HexColor}" 
                                             Stroke="{DynamicResource SukiBorderBrush}"
                                             StrokeThickness="1" />
                                    <TextBlock Text="{Binding Name}" 
                                               VerticalAlignment="Center" 
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SukiText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Spacing="10" Margin="15,20,15,15"
                    IsVisible="{Binding SelectedPicture, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Button Classes="Primary"
                    Command="{Binding EditMetadataCommand}"
                    HorizontalAlignment="Stretch"
                    Height="40">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="Pencil" Width="18" Height="18" />
                    <TextBlock Text="Edit" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button Classes="Accent"
                    Command="{Binding DeleteAssetCommand}"
                    HorizontalAlignment="Stretch"
                    Height="40"
                    Background="#CC3333">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="Delete" Width="18" Height="18" />
                    <TextBlock Text="Delete" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
