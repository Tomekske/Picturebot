<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Picturebot.ViewModels"
             x:DataType="vm:ImportProgressDialogViewModel"
             x:Class="Picturebot.Views.ImportProgressDialog"
             Width="400">
    <Border Background="{DynamicResource SukiBackground}"
            CornerRadius="12"
            BoxShadow="0 4 20 0 #22000000"
            Padding="24">
        <StackPanel Spacing="20">
            <TextBlock Text="Importing Pictures..."
                       FontSize="18"
                       FontWeight="SemiBold" />

            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="{Binding CurrentFile}"
                               FontSize="12"
                               Foreground="{DynamicResource SukiLowText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Percentage, StringFormat={}{0:0}%}"
                               FontSize="12"
                               FontWeight="Bold" />
                </Grid>

                <ProgressBar Value="{Binding Percentage}"
                             Minimum="0"
                             Maximum="100"
                             Height="10"
                             CornerRadius="5" />

                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SukiLowText}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
